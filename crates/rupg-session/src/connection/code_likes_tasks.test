> INSERT INTO lt SELECT i, CASE WHEN i % 11 = 0 THEN NULL WHEN i % 7 = 0 THEN 'Google' || (i % 89) WHEN i % 5 = 0 THEN '' ELSE 'p' || (i % 97) || 'é' END, i % 13 FROM generate_series(1, 300000) i
