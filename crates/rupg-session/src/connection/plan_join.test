!details
> SET TimeZone = 'UTC'
SET
> CREATE TABLE ja (id int, k int, s int, t text, n int);
CREATE TABLE
> INSERT INTO ja SELECT x, x % 50, CASE WHEN x % 10 < 6 THEN 1 WHEN x % 10 < 8 THEN 2 ELSE x END, 'k' || (x % 20), CASE WHEN x % 4 = 0 THEN NULL ELSE x % 30 END FROM generate_series(1, 5000) x;
INSERT 0 5000
> CREATE TABLE jb (id int, k int, s int, t text, n int);
CREATE TABLE
> INSERT INTO jb SELECT x, x % 80, CASE WHEN x % 5 = 0 THEN 1 ELSE x + 100 END, 'k' || (x % 30), CASE WHEN x % 2 = 0 THEN NULL ELSE x % 45 END FROM generate_series(1, 3000) x;
INSERT 0 3000
> CREATE TABLE jc (id int PRIMARY KEY, k int, v int);
CREATE TABLE
> INSERT INTO jc SELECT x, x % 7, x * 3 FROM generate_series(1, 2000) x;
INSERT 0 2000
> CREATE TABLE jd (k int, w int);
CREATE TABLE
> INSERT INTO jd SELECT x % 300, x FROM generate_series(1, 900) x;
INSERT 0 900
> ANALYZE ja;
ANALYZE
> ANALYZE jb;
ANALYZE
> ANALYZE jc;
ANALYZE
> ANALYZE jd;
ANALYZE
