> CREATE VIEW wv3 AS SELECT s.g, rank() OVER (w ORDER BY s.g DESC NULLS LAST), percent_rank() OVER (PARTITION BY s.g % 2, s.g / 3 ORDER BY s.g USING >) FROM (SELECT g, row_number() OVER () AS n FROM generate_series(1, 4) AS g) AS s WINDOW w AS (PARTITION BY s.g % 2, s.g / 3), unused AS (ORDER BY s.n)
CREATE VIEW
> SELECT pg_get_viewdef('wv3'::regclass, true)
fields pg_get_viewdef:25:-1:-1
row  SELECT g,
    rank() OVER (w ORDER BY g DESC NULLS LAST) AS rank,
    percent_rank() OVER (PARTITION BY (g % 2), (g / 3) ORDER BY g DESC) AS percent_rank
   FROM ( SELECT g.g,
            row_number() OVER () AS n
           FROM generate_series(1, 4) g(g)) s
  WINDOW w AS (PARTITION BY (g % 2), (g / 3)), unused AS (ORDER BY n);
