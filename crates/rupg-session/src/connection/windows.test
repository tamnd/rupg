> CREATE VIEW wv AS SELECT g, rank() OVER (PARTITION BY g % 2 ORDER BY g DESC) AS r, lag(g, 1, 0) OVER w, first_value(g) OVER (w), row_number() OVER (ORDER BY g + 1), nth_value(g, 2) OVER w2 FROM generate_series(1, 4) AS g WINDOW w AS (ORDER BY g), w2 AS (PARTITION BY g), w3 AS (w)
CREATE VIEW
> SELECT pg_get_viewdef('wv'::regclass, true)
fields pg_get_viewdef:25:-1:-1
row  SELECT g,
    rank() OVER (PARTITION BY (g % 2) ORDER BY g DESC) AS r,
    lag(g, 1, 0) OVER w AS lag,
    first_value(g) OVER w3 AS first_value,
    row_number() OVER (ORDER BY (g + 1)) AS row_number,
    nth_value(g, 2) OVER w2 AS nth_value
   FROM generate_series(1, 4) g(g)
  WINDOW w AS (ORDER BY g), w2 AS (PARTITION BY g), w3 AS (w);
