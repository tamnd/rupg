> create table rd (f1 int, f2 text, f3 int, f4 bigint);
CREATE TABLE
> create view rdv as select f1, f2 from rd;
CREATE VIEW
> create rule rdv_i as on insert to rdv do instead insert into rd values (new.*, 57) returning f1, f2;
CREATE RULE
> create rule rdv_u as on update to rdv do instead update rd set f1 = new.f1, f2 = new.f2 where f1 = old.f1 returning f1, f2;
CREATE RULE
> create rule rdv_d as on delete to rdv do instead delete from rd where f1 = old.f1 returning f1, f2;
CREATE RULE
> create rule rd_del as on delete to rd do instead update rd set f2 = f2 || ' (deleted)', f3 = -1, f4 = -1 where f1 = old.f1 returning *;
CREATE RULE
> create table rl (a int, b int, c int);
CREATE TABLE
> create rule rl_r as on insert to rl do instead insert into rd (f1, f4) select new.a, new.c returning f1, f1 + 1, f1 + 2;
CREATE RULE
> create rule rl_u as on update to rl do also update rd set f2 = 'x' from rl r2 where r2.b = rd.f3 and rd.f1 = new.a;
CREATE RULE
