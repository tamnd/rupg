> CREATE VIEW wagg_v AS SELECT k, sum(v) FILTER (WHERE v > 5) OVER (PARTITION BY p ORDER BY k), count(*) OVER w, avg(n) OVER w FROM wagg_t WINDOW w AS (PARTITION BY p)
CREATE VIEW
> SELECT pg_get_viewdef('wagg_v'::regclass)
fields pg_get_viewdef:25:-1:-1
row  SELECT k,
    sum(v) FILTER (WHERE (v > 5)) OVER (PARTITION BY p ORDER BY k) AS sum,
    count(*) OVER w AS count,
    avg(n) OVER w AS avg
   FROM wagg_t
  WINDOW w AS (PARTITION BY p);
