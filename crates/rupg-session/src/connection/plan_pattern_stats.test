!details
> SET TimeZone = 'UTC'
SET
> CREATE TABLE ps (t text, s text, v varchar(20), n text, c char(6), b bytea, few text);
CREATE TABLE
> INSERT INTO ps SELECT 'item' || x, 'k' || (x % 40), 'v' || (x % 1000), CASE WHEN x % 5 = 0 THEN NULL ELSE 'n' || x END, 'c' || (x % 300), ('\x' || lpad(to_hex(x % 4000), 4, '0'))::bytea, CASE WHEN x % 3 = 0 THEN 'apple' WHEN x % 3 = 1 THEN 'banana' ELSE 'cherry' END FROM generate_series(1, 10000) x;
INSERT 0 10000
> ALTER TABLE ps ALTER COLUMN v SET STATISTICS 30;
ALTER TABLE
> ALTER TABLE ps ALTER COLUMN c SET STATISTICS 5;
ALTER TABLE
> ANALYZE ps;
ANALYZE
> EXPLAIN SELECT * FROM ps WHERE t LIKE 'item1%';
fields QUERY PLAN:25:-1:-1
row Seq Scan on ps  (cost=0.00..212.00 rows=1111 width=36)
row   Filter: (t ~~ 'item1%'::text)
EXPLAIN
