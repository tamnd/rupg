> CREATE TABLE rn (n int, name text)
CREATE TABLE
> INSERT INTO rn SELECT i, 'N' || i FROM generate_series(0, 9) i
INSERT 0 10
> CREATE TABLE rs (s int, n int)
CREATE TABLE
> INSERT INTO rs SELECT i, i % 10 FROM generate_series(0, 299) i
INSERT 0 300
> CREATE TABLE rc (c int, n int)
CREATE TABLE
> INSERT INTO rc SELECT i, (i * 3) % 10 FROM generate_series(0, 499) i
INSERT 0 500
> CREATE TABLE ro (o int, c int)
CREATE TABLE
> INSERT INTO ro SELECT i, (i * 7) % 500 FROM generate_series(1, 3000) i
INSERT 0 3000
> CREATE TABLE rl (o int, s int, q int, d date)
CREATE TABLE
> INSERT INTO rl SELECT CASE WHEN i % 23 = 0 THEN NULL ELSE i / 3 END, (i * 37 + i / 11) % 300, CASE WHEN i % 31 = 0 THEN NULL ELSE i % 50 END, date '2000-01-01' + i % 400 FROM generate_series(1, 9000) i
INSERT 0 9000
