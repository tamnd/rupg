> CREATE SCHEMA vw
CREATE SCHEMA
> CREATE TABLE vw.t (a int, b text)
CREATE TABLE
> CREATE VIEW vw.v1 AS WITH x AS (SELECT a FROM vw.t) SELECT * FROM x
CREATE VIEW
> CREATE VIEW vw.v2 AS WITH x(p, q) AS (SELECT a, b FROM vw.t WHERE a > 1), y AS MATERIALIZED (SELECT p FROM x) SELECT x.q, y.p FROM x JOIN y ON x.p = y.p
CREATE VIEW
> CREATE VIEW vw.v3 AS WITH RECURSIVE r(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM r WHERE n < 5) SELECT n FROM r
CREATE VIEW
> CREATE VIEW vw.v4 AS WITH x AS NOT MATERIALIZED (SELECT 1 AS k) SELECT z.k, x.k AS k2 FROM x AS z, x
CREATE VIEW
> CREATE VIEW vw.v5 AS SELECT a, (WITH c AS (SELECT count(*) AS n FROM vw.t s WHERE s.a = t.a) SELECT n FROM c) AS n FROM vw.t
CREATE VIEW
> CREATE VIEW vw.v6 AS SELECT * FROM (WITH x AS (SELECT 2 AS m) SELECT m FROM x) s
CREATE VIEW
> CREATE VIEW vw.v7 AS WITH RECURSIVE r AS (SELECT 1 AS n, 'a'::text AS s UNION SELECT n + 1, s || 'b' FROM r WHERE n < 3) SELECT * FROM r r2(i, j) ORDER BY i
CREATE VIEW
> CREATE VIEW vw.v8 AS WITH "Q" AS (SELECT 1 AS "X") SELECT "X" FROM "Q"
CREATE VIEW
> CREATE VIEW vw.v9 AS WITH x AS (SELECT a FROM vw.t) SELECT a FROM x UNION ALL SELECT a FROM x
CREATE VIEW
> CREATE VIEW vw.v10 AS WITH x AS (SELECT 1 AS a), y AS (WITH x AS (SELECT 2 AS a) SELECT a FROM x) SELECT x.a, y.a AS b FROM x, y
CREATE VIEW
> CREATE VIEW vw.v11 AS WITH x AS (VALUES (1, 'one'), (2, 'two')) SELECT * FROM x
CREATE VIEW
