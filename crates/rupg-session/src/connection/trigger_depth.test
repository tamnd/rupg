> CREATE FUNCTION td_rec() RETURNS trigger LANGUAGE plpgsql AS $$
>> BEGIN
>>   RAISE NOTICE 'td_rec %: depth = %', new.i, pg_trigger_depth();
>>   IF pg_trigger_depth() < 4 THEN
>>     INSERT INTO td_r VALUES (new.i + 1);
>>   END IF;
>>   RETURN new;
>> END $$;
CREATE FUNCTION
