> CREATE FUNCTION td_catch() RETURNS trigger LANGUAGE plpgsql AS $$
>> BEGIN
>>   BEGIN
>>     INSERT INTO td_b VALUES (-5);
>>   EXCEPTION WHEN raise_exception THEN
>>     RAISE NOTICE 'caught: depth = %', pg_trigger_depth();
>>   END;
>>   RETURN NULL;
>> END $$;
CREATE FUNCTION
