> CREATE FUNCTION td_a_f() RETURNS trigger LANGUAGE plpgsql AS $$
>> BEGIN
>>   RAISE NOTICE '% % %: depth = %', tg_name, tg_when, tg_level, pg_trigger_depth();
>>   IF tg_level = 'ROW' AND tg_when = 'BEFORE' THEN
>>     INSERT INTO td_b VALUES (new.i);
>>   END IF;
>>   RETURN new;
>> END $$;
CREATE FUNCTION
> CREATE FUNCTION td_b_f() RETURNS trigger LANGUAGE plpgsql AS $$
>> BEGIN
>>   RAISE NOTICE '% % %: depth = %', tg_name, tg_when, tg_level, pg_trigger_depth();
>>   IF new.i < 0 THEN
>>     RAISE EXCEPTION 'negative %', new.i;
>>   END IF;
>>   RETURN new;
>> END $$;
CREATE FUNCTION
> CREATE TRIGGER td_a_bs BEFORE INSERT ON td_a FOR EACH STATEMENT EXECUTE FUNCTION td_a_f();
