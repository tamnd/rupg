> create table pix (unique1 int, unique2 int, stringu1 name)
CREATE TABLE
> insert into pix select g, 1000 - g, (case when g % 3 = 0 then 'A' else 'C' end || g)::name from generate_series(1, 1000) g
INSERT 0 1000
> create index pix_u2_prtl on pix (unique2) where stringu1 < 'B'::name
CREATE INDEX
> analyze pix
ANALYZE
> explain (costs off) select * from pix where unique2 = 10 and stringu1 = 'A990'::name
