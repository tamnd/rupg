>> -- Triggers and generated columns of the base table
>> CREATE TABLE gbase (id int, v int, g int GENERATED ALWAYS AS (v * 2) STORED);
CREATE TABLE
> CREATE FUNCTION trig_fn() RETURNS trigger LANGUAGE plpgsql AS $$
>> BEGIN
>>   RAISE NOTICE '% % % on %', TG_NAME, TG_WHEN, TG_OP, TG_TABLE_NAME;
>>   IF TG_LEVEL = 'ROW' THEN
>>     IF TG_OP = 'DELETE' THEN RETURN OLD; END IF;
>>     RETURN NEW;
>>   END IF;
>>   RETURN NULL;
>> END
>> $$;
CREATE FUNCTION
> CREATE TRIGGER gbase_row BEFORE INSERT OR UPDATE OR DELETE ON gbase FOR EACH ROW EXECUTE FUNCTION trig_fn();
CREATE TRIGGER
> CREATE TRIGGER gbase_stmt AFTER INSERT OR UPDATE OR DELETE ON gbase FOR EACH STATEMENT EXECUTE FUNCTION trig_fn();
CREATE TRIGGER
> CREATE VIEW gview AS SELECT id, v, g FROM gbase;
CREATE VIEW
> CREATE TRIGGER gview_stmt BEFORE INSERT OR UPDATE OR DELETE ON gview FOR EACH STATEMENT EXECUTE FUNCTION trig_fn();
CREATE TRIGGER
