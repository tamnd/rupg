!details
> SET TimeZone = 'UTC'
SET
> CREATE TABLE bt1 (a int, b int, t text, n int, f float8, c bigint);
CREATE TABLE
> INSERT INTO bt1 SELECT x, x % 100, 'v' || (x % 500), CASE WHEN x % 3 = 0 THEN NULL ELSE x % 50 END, x % 100, x FROM generate_series(1, 10000) x;
INSERT 0 10000
> CREATE INDEX bt1_a ON bt1 (a);
CREATE INDEX
> CREATE INDEX bt1_b ON bt1 (b);
CREATE INDEX
> CREATE INDEX bt1_t ON bt1 (t);
CREATE INDEX
> CREATE INDEX bt1_n ON bt1 (n);
CREATE INDEX
> CREATE INDEX bt1_f ON bt1 (f);
CREATE INDEX
> CREATE INDEX bt1_ba ON bt1 (b, a);
CREATE INDEX
> CREATE INDEX bt1_tb ON bt1 (t, b);
CREATE INDEX
> CREATE INDEX bt1_ainc ON bt1 (c) INCLUDE (t);
CREATE INDEX
> CREATE INDEX bt1_bdesc ON bt1 (b DESC, c);
CREATE INDEX
> CREATE INDEX bt1_ff ON bt1 (c, a) WITH (fillfactor = 50);
CREATE INDEX
> CREATE INDEX bt1_nodup ON bt1 (n, t) WITH (deduplicate_items = off);
CREATE INDEX
> ANALYZE bt1;
ANALYZE
> CREATE TABLE bt2 (a int PRIMARY KEY, b text);
CREATE TABLE
> INSERT INTO bt2 SELECT x, repeat('w', x % 40) FROM generate_series(1, 5000) x;
INSERT 0 5000
> CREATE INDEX bt2_b ON bt2 (b);
CREATE INDEX
> ANALYZE bt2;
ANALYZE
> CREATE TABLE bt3 (a bigint, b int);
CREATE TABLE
> INSERT INTO bt3 SELECT x, x % 1000 FROM generate_series(1, 60000) x;
INSERT 0 60000
> CREATE INDEX bt3_a ON bt3 (a);
CREATE INDEX
> CREATE INDEX bt3_b ON bt3 (b);
CREATE INDEX
> ANALYZE bt3;
