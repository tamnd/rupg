> SELECT q, ts_rewrite(q, 'cat'::tsquery, 'dog | wolf') FROM (VALUES ('cat & fat'::tsquery), ('!cat'), ('cat <-> rat'), ('rat | cat | bat'), ('(cat & rat) | (cat & bat)'), ('cat')) AS t(q)
