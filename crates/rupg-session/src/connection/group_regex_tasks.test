> INSERT INTO gr SELECT i % 3, CASE WHEN i % 17 = 0 THEN NULL WHEN i % 13 = 0 THEN '' WHEN i % 7 = 0 THEN 'ftp://f' || (i % 3) ELSE 'http' || CASE WHEN i % 2 = 0 THEN 's' ELSE '' END || '://' || CASE WHEN i % 3 = 0 THEN 'www.' ELSE '' END || CASE WHEN i % 5 = 0 THEN 'жж' ELSE 'h' END || (i % 40) || '.ex/' || (i % 1000) || CASE WHEN i % 4 = 0 THEN 'é' ELSE '' END END FROM generate_series(1, 300000) i
