> create table smr (id int primary key, parent int references smr, data text, nchildren int not null default 0)
CREATE TABLE
> create function smr_ins() returns trigger language plpgsql as $$ begin if new.parent is not null then update smr set nchildren = nchildren + 1 where id = new.parent; end if; return new; end; $$
CREATE FUNCTION
> create trigger smr_ins before insert on smr for each row execute procedure smr_ins()
CREATE TRIGGER
> create function smr_del() returns trigger language plpgsql as $$ begin if old.parent is not null then update smr set nchildren = nchildren - 1 where id = old.parent; end if; return old; end; $$
CREATE FUNCTION
> create trigger smr_del before delete on smr for each row execute procedure smr_del()
CREATE TRIGGER
