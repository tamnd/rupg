!details
> create table smp (aid int not null primary key, val1 text, val2 text, bcnt int not null default 0)
CREATE TABLE
> create table smc (bid int not null primary key, aid int not null, val1 text)
CREATE TABLE
> create function smp_upd() returns trigger language plpgsql as $$ begin if old.val1 <> new.val1 then new.val2 = new.val1; delete from smc where smc.aid = new.aid and smc.val1 = new.val1; end if; return new; end; $$
CREATE FUNCTION
> create trigger smp_upd before update on smp for each row execute procedure smp_upd()
CREATE TRIGGER
> create function smp_del() returns trigger language plpgsql as $$ begin delete from smc where aid = old.aid; return old; end; $$
CREATE FUNCTION
> create trigger smp_del before delete on smp for each row execute procedure smp_del()
CREATE TRIGGER
> create function smc_ins() returns trigger language plpgsql as $$ begin update smp set bcnt = bcnt + 1 where aid = new.aid; return new; end; $$
CREATE FUNCTION
> create trigger smc_ins after insert on smc for each row execute procedure smc_ins()
CREATE TRIGGER
> create function smc_del() returns trigger language plpgsql as $$ begin update smp set bcnt = bcnt - 1 where aid = old.aid; return old; end; $$
CREATE FUNCTION
> create trigger smc_del after delete on smc for each row execute procedure smc_del()
CREATE TRIGGER
