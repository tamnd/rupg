> create table price (id int, active boolean, price numeric);
CREATE TABLE
> create type price_input as (id int, price numeric);
CREATE TYPE
> create type price_key as (id int);
CREATE TYPE
> create function price_key_from_table(price) returns price_key as $$ select $1.id $$ language sql;
