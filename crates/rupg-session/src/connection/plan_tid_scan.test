row   ->  Tid Scan on tidscan t2  (cost=0.00..4.01 rows=1 width=10)
row         TID Cond: (t1.ctid = ctid)
EXPLAIN
> EXPLAIN SELECT t1.ctid, t1.*, t2.ctid, t2.* FROM tidscan t1 LEFT JOIN tidscan t2 ON t1.ctid = t2.ctid WHERE t1.id = 1;
fields QUERY PLAN:25:-1:-1
row Nested Loop Left Join  (cost=0.00..94.17 rows=13 width=20)
row   ->  Seq Scan on tidscan t1  (cost=0.00..41.88 rows=13 width=10)
row         Filter: (id = 1)
row   ->  Tid Scan on tidscan t2  (cost=0.00..4.01 rows=1 width=10)
row         TID Cond: (t1.ctid = ctid)
EXPLAIN
