CREATE RULE
> CREATE FUNCTION f1(int) RETURNS void LANGUAGE sql BEGIN ATOMIC UPDATE t SET b = 'z' WHERE a = $1; UPDATE t AS q SET b = k.z FROM k WHERE q.a = k.x; DELETE FROM t WHERE a > $1; DELETE FROM ONLY p USING k; END;
CREATE FUNCTION
> SELECT pg_get_functiondef('f1'::regproc);
fields pg_get_functiondef:25:-1:-1
row CREATE OR REPLACE FUNCTION vru.f1(integer)
 RETURNS void
 LANGUAGE sql
BEGIN ATOMIC
 UPDATE t SET b = 'z'::text
   WHERE (t.a = $1);
 UPDATE t q SET b = k.z
    FROM k
   WHERE (q.a = k.x);
 DELETE FROM t
   WHERE (t.a > $1);
 DELETE FROM ONLY p
    USING k;
END

SELECT 1
> SELECT rulename, pg_get_ruledef(oid) FROM pg_rewrite WHERE ev_class = 's'::regclass ORDER BY 1;
fields rulename@pg_rewrite.2:19:64:-1,pg_get_ruledef:25:-1:-1
row r1,CREATE RULE r1 AS
    ON UPDATE TO vru.s DO  UPDATE t SET b = new.y
  WHERE (t.a = old.x);
row r2,CREATE RULE r2 AS
    ON UPDATE TO vru.s DO  UPDATE t tt SET a = (tt.a + 1), b = DEFAULT, c[1] = new.x, d.p = 5, d.q[2] = 6;
row r3,CREATE RULE r3 AS
    ON DELETE TO vru.s DO  DELETE FROM t
  WHERE ((t.a = old.x) AND (t.b = old.y));
row r4,CREATE RULE r4 AS
    ON DELETE TO vru.s DO INSTEAD  DELETE FROM t q
   USING k
  WHERE ((q.a = k.x) AND (k.z = old.y));
row r5,CREATE RULE r5 AS
    ON INSERT TO vru.s DO  UPDATE t SET b = k.z
   FROM k
  WHERE ((t.a = k.x) AND (k.x = new.x));
row r6,CREATE RULE r6 AS
    ON INSERT TO vru.s DO ( DELETE FROM t;
 UPDATE ONLY p SET a = 1;
 DELETE FROM ONLY p
  WHERE (p.b IS NULL);
);
row r7,CREATE RULE r7 AS
    ON UPDATE TO vru.s
   WHERE (old.x <> new.x) DO  UPDATE t SET a = new.x, b = new.y
  WHERE (t.a = old.x);
row r8,CREATE RULE r8 AS
    ON UPDATE TO vru.s DO  UPDATE t SET (a, b) = ( SELECT k.x,
            k.z
           FROM k
          WHERE (k.x = new.x)), c[2] = 3
  WHERE (t.a = old.x);
SELECT 8
> SELECT rulename, pg_get_ruledef(oid, true) FROM pg_rewrite WHERE ev_class = 's'::regclass ORDER BY 1;
fields rulename@pg_rewrite.2:19:64:-1,pg_get_ruledef:25:-1:-1
row r1,CREATE RULE r1 AS
    ON UPDATE TO s DO  UPDATE t SET b = new.y
  WHERE t.a = old.x;
row r2,CREATE RULE r2 AS
    ON UPDATE TO s DO  UPDATE t tt SET a = tt.a + 1, b = DEFAULT, c[1] = new.x, d.p = 5, d.q[2] = 6;
row r3,CREATE RULE r3 AS
    ON DELETE TO s DO  DELETE FROM t
  WHERE t.a = old.x AND t.b = old.y;
row r4,CREATE RULE r4 AS
    ON DELETE TO s DO INSTEAD  DELETE FROM t q
   USING k
  WHERE q.a = k.x AND k.z = old.y;
row r5,CREATE RULE r5 AS
    ON INSERT TO s DO  UPDATE t SET b = k.z
   FROM k
  WHERE t.a = k.x AND k.x = new.x;
row r6,CREATE RULE r6 AS
    ON INSERT TO s DO ( DELETE FROM t;
 UPDATE ONLY p SET a = 1;
 DELETE FROM ONLY p
  WHERE p.b IS NULL;
);
row r7,CREATE RULE r7 AS
    ON UPDATE TO s
   WHERE old.x <> new.x DO  UPDATE t SET a = new.x, b = new.y
  WHERE t.a = old.x;
row r8,CREATE RULE r8 AS
    ON UPDATE TO s DO  UPDATE t SET (a, b) = ( SELECT k.x,
            k.z
           FROM k
          WHERE k.x = new.x), c[2] = 3
  WHERE t.a = old.x;
