    bool,
    "numeric",
    domain
   FROM JSON_TABLE(
            'null'::jsonb, '$[*]' AS json_table_path_0
            PASSING
                (1 + 2) AS a,
                '"foo"'::json AS "b c"
            COLUMNS (
                "int" integer PATH '$',
                text text PATH '$',
                "char(4)" character(4) PATH '$',
                bool boolean PATH '$',
                "numeric" numeric PATH '$',
                domain jt_dom PATH '$'
            )
