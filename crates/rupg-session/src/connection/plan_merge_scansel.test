!details
> SET TimeZone = 'UTC'
SET
> CREATE TABLE mj1 (a int, b int, t text);
CREATE TABLE
> CREATE TABLE mj2 (a int, b int, t text);
CREATE TABLE
> CREATE TABLE mj3 (a int, n int);
CREATE TABLE
> INSERT INTO mj1 SELECT x, x % 50, 'k' || (x % 300) FROM generate_series(1, 5000) x;
INSERT 0 5000
> INSERT INTO mj2 SELECT x + 2000, x % 20, 'k' || (x % 100) FROM generate_series(1, 4000) x;
INSERT 0 4000
> INSERT INTO mj3 SELECT x * 3, CASE WHEN x % 4 = 0 THEN NULL ELSE x END FROM generate_series(1, 1000) x;
INSERT 0 1000
> CREATE INDEX mj1_a ON mj1 (a);
CREATE INDEX
> CREATE INDEX mj2_a ON mj2 (a);
CREATE INDEX
> ANALYZE mj1, mj2, mj3;
ANALYZE
