> CREATE FUNCTION pc_poly(x anycompatible, y anycompatible, OUT f1 anycompatible, OUT f2 anycompatiblearray) LANGUAGE plpgsql AS $$ BEGIN f1 := x; f2 := ARRAY[x, y]; END $$;
