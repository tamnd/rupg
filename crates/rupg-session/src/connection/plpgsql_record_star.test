row (5,five)
SELECT 1
> CREATE FUNCTION g() RETURNS SETOF t LANGUAGE plpgsql AS $$
>> DECLARE
>>   r t;
>>   rec record;
>> BEGIN
>>   r := row(7, 'seven');
>>   RETURN QUERY SELECT r.*;
>>   SELECT 8 AS a, 'eight'::text AS b INTO rec;
>>   RAISE NOTICE 'rec=% r=%', rec.*::text, row(r.*);
>>   RETURN QUERY SELECT (rec.*).*;
>> END $$;
CREATE FUNCTION
