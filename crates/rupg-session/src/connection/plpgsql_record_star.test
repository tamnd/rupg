NOTICE 00000 distinct (PL/pgSQL function trg() line 9 at RAISE)
UPDATE 2
> CREATE FUNCTION f(r t) RETURNS text LANGUAGE plpgsql AS $$
>> DECLARE
>>   s text;
>>   n int;
>> BEGIN
>>   SELECT r.* INTO n, s;
>>   RAISE NOTICE 'n=% s=%', n, s;
>>   RETURN (SELECT string_agg(x::text, ',') FROM (SELECT r.*) x);
>> END $$;
CREATE FUNCTION
> SELECT f(row(5, 'five')::t);
fields f:25:-1:-1
