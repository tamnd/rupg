> CREATE TABLE t (a int, b text);
CREATE TABLE
> INSERT INTO t VALUES (1, 'x'), (2, 'y');
INSERT 0 2
> CREATE FUNCTION trg() RETURNS trigger LANGUAGE plpgsql AS $$
>> BEGIN
>>   IF row(old.*) = row(new.*) THEN
>>     RAISE NOTICE 'row % not changed', new.a;
>>   ELSE
>>     RAISE NOTICE 'row % changed: % -> %', new.a, old.*::text, new.*::text;
>>   END IF;
>>   IF row(old.*) IS DISTINCT FROM row(new.*) THEN
>>     RAISE NOTICE 'distinct';
>>   END IF;
>>   RETURN new;
>> END $$;
CREATE FUNCTION
> CREATE TRIGGER trg BEFORE UPDATE ON t FOR EACH ROW EXECUTE FUNCTION trg();
CREATE TRIGGER
> UPDATE t SET b = CASE WHEN a = 1 THEN b ELSE 'z' END;
