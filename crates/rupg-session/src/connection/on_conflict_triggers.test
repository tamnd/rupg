> CREATE FUNCTION cf() RETURNS trigger LANGUAGE plpgsql AS $$
>> BEGIN
>>   IF TG_OP = 'UPDATE' AND new.b = 7 THEN RETURN NULL; END IF;
>>   IF TG_OP = 'UPDATE' THEN new.b := new.b * 10; END IF;
>>   RETURN new;
>> END $$;
