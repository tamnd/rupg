> CREATE FUNCTION rich(min numeric) RETURNS SETOF emp AS $$
>> DECLARE
>>   r record;
>> BEGIN
>>   FOR r IN SELECT * FROM emp WHERE salary >= min ORDER BY id LOOP
>>     RETURN NEXT r;
>>   END LOOP;
>>   RETURN;
>> END
>> $$ LANGUAGE plpgsql;
