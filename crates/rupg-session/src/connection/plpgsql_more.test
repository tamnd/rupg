> CREATE FUNCTION nested_handler() RETURNS text AS $$
>> BEGIN
>>   BEGIN
>>     RAISE EXCEPTION 'inner';
>>   EXCEPTION WHEN OTHERS THEN
>>     BEGIN
>>       RAISE EXCEPTION 'second: %', SQLERRM;
>>     EXCEPTION WHEN OTHERS THEN
>>       RETURN SQLERRM;
>>     END;
>>   END;
>> END
>> $$ LANGUAGE plpgsql;
CREATE FUNCTION
