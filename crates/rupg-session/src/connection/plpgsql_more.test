> CREATE FUNCTION fib(n int) RETURNS int AS $$
>> BEGIN
>>   IF n < 2 THEN
>>     RETURN n;
>>   END IF;
>>   RETURN fib(n - 1) + fib(n - 2);
>> END
>> $$ LANGUAGE plpgsql;
