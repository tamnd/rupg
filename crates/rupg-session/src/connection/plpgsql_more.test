> CREATE FUNCTION reraise() RETURNS int AS $$
>> BEGIN
>>   BEGIN
>>     PERFORM 1 / 0;
>>   EXCEPTION WHEN OTHERS THEN
>>     RAISE NOTICE 'caught %', SQLSTATE;
>>     RAISE;
>>   END;
>>   RETURN 1;
>> END
>> $$ LANGUAGE plpgsql;
