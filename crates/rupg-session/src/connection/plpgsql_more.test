> CREATE FUNCTION writes(n int) RETURNS int AS $$
>> DECLARE
>>   c int;
>> BEGIN
>>   INSERT INTO emp VALUES (n, 'new' || n, 10, 40);
>>   UPDATE emp SET salary = salary + 1 WHERE id = n;
>>   SELECT count(*) INTO c FROM emp;
>>   BEGIN
>>     DELETE FROM emp WHERE id = n;
>>     RAISE EXCEPTION 'undo';
>>   EXCEPTION WHEN raise_exception THEN
>>     NULL;
>>   END;
>>   RETURN c;
>> END
>> $$ LANGUAGE plpgsql;
CREATE FUNCTION
