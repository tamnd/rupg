> CREATE FUNCTION labels() RETURNS text AS $$
>> DECLARE
>>   s text := '';
>> BEGIN
>>   <<outer>>
>>   FOR i IN 1..3 LOOP
>>     <<inner>>
>>     FOR j IN 1..3 LOOP
>>       CONTINUE outer WHEN j > i;
>>       EXIT outer WHEN i = 3;
>>       s := s || i || j || ' ';
>>     END LOOP inner;
>>   END LOOP outer;
>>   RETURN s;
>> END
>> $$ LANGUAGE plpgsql;
CREATE FUNCTION
> SELECT labels();
fields labels:25:-1:-1
row 11 21 22 
SELECT 1
> CREATE FUNCTION steps() RETURNS text AS $$
>> DECLARE
>>   s text := '';
>>   n int := 0;
>> BEGIN
>>   FOR i IN REVERSE 10..1 BY 3 LOOP
>>     s := s || i || ',';
>>   END LOOP;
>>   WHILE n < 3 LOOP
>>     n := n + 1;
>>     s := s || 'w' || n;
>>   END LOOP;
>>   LOOP
>>     n := n - 1;
>>     EXIT WHEN n = 0;
>>   END LOOP;
>>   FOREACH n IN ARRAY ARRAY[7, 8, 9] LOOP
>>     s := s || '[' || n || ']';
>>   END LOOP;
>>   RETURN s;
>> END
>> $$ LANGUAGE plpgsql;
CREATE FUNCTION
> SELECT steps();
fields steps:25:-1:-1
row 10,7,4,1,w1w2w3[7][8][9]
SELECT 1
> CREATE FUNCTION errs(k int) RETURNS text AS $$
>> DECLARE
>>   msg text;
>>   st text;
>>   det text;
>>   hnt text;
>> BEGIN
>>   BEGIN
>>     IF k = 1 THEN
>>       PERFORM 1 / 0;
>>     ELSIF k = 2 THEN
>>       RAISE EXCEPTION USING ERRCODE = 'unique_violation', MESSAGE = 'dup', DETAIL = 'the detail', HINT = 'the hint';
>>     ELSIF k = 3 THEN
>>       RAISE invalid_parameter_value;
>>     ELSIF k = 4 THEN
>>       RAISE SQLSTATE '22012' USING MESSAGE = 'custom zero';
>>     ELSE
>>       INSERT INTO emp VALUES (1, 'again', 0, 0);
>>     END IF;
>>   EXCEPTION
>>     WHEN division_by_zero THEN
>>       GET STACKED DIAGNOSTICS msg = MESSAGE_TEXT, st = RETURNED_SQLSTATE;
>>       RETURN 'div: ' || st || ' ' || msg;
>>     WHEN unique_violation THEN
>>       GET STACKED DIAGNOSTICS det = PG_EXCEPTION_DETAIL, hnt = PG_EXCEPTION_HINT;
>>       RETURN 'uniq: ' || SQLSTATE || ' ' || SQLERRM || ' / ' || det || ' / ' || hnt;
>>     WHEN data_exception THEN
>>       RETURN 'data: ' || SQLSTATE || ' ' || SQLERRM;
>>   END;
>>   RETURN 'none';
>> END
>> $$ LANGUAGE plpgsql;
CREATE FUNCTION
