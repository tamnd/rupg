> CREATE FUNCTION ret_into(n int) RETURNS text AS $$
>> DECLARE
>>   r record;
>>   k int;
>> BEGIN
>>   UPDATE emp SET salary = 5 WHERE id = n RETURNING id, name INTO r;
>>   GET DIAGNOSTICS k = ROW_COUNT;
>>   RETURN r.name || ' ' || k || ' ' || FOUND;
>> END
>> $$ LANGUAGE plpgsql;
