> CREATE FUNCTION by_dept(d int) RETURNS TABLE (who text, pay numeric) AS $$
>> BEGIN
>>   RETURN QUERY SELECT name, salary FROM emp WHERE dept = d ORDER BY id;
>>   RETURN QUERY EXECUTE 'SELECT name || $1, salary FROM emp WHERE id = $2' USING '!', 4;
>> END
>> $$ LANGUAGE plpgsql;
