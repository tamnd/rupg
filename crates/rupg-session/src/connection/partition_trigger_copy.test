> SET TimeZone = 'UTC'
SET
> CREATE FUNCTION tf() RETURNS trigger LANGUAGE plpgsql AS $$
>> BEGIN
>>   RAISE NOTICE '% % % % on %', TG_NAME, TG_WHEN, TG_LEVEL, TG_OP, TG_TABLE_NAME;
>>   IF TG_LEVEL = 'ROW' AND TG_OP <> 'DELETE' THEN
>>     RAISE NOTICE 'new %', NEW;
>>     IF NEW.b = 'skip' THEN RETURN NULL; END IF;
>>     RETURN NEW;
>>   END IF;
>>   IF TG_LEVEL = 'ROW' THEN
>>     RAISE NOTICE 'old %', OLD;
>>     RETURN OLD;
>>   END IF;
>>   RETURN NULL;
>> END $$;
CREATE FUNCTION
> CREATE TABLE p (a int PRIMARY KEY, b text) PARTITION BY RANGE (a);
CREATE TABLE
