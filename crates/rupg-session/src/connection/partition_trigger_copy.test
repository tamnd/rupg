> CREATE FUNCTION cnt() RETURNS trigger LANGUAGE plpgsql AS $$
>> BEGIN
>>   IF TG_OP = 'INSERT' THEN
>>     RAISE NOTICE '% new %', TG_NAME, (SELECT string_agg(a || ':' || b, ',' ORDER BY a) FROM newt);
>>   ELSIF TG_OP = 'UPDATE' THEN
>>     RAISE NOTICE '% old % new %', TG_NAME, (SELECT string_agg(a || ':' || b, ',' ORDER BY a) FROM oldt), (SELECT string_agg(a || ':' || b, ',' ORDER BY a) FROM newt);
>>   ELSE
>>     RAISE NOTICE '% old %', TG_NAME, (SELECT string_agg(a || ':' || b, ',' ORDER BY a) FROM oldt);
>>   END IF;
>>   RETURN NULL;
>> END $$;
CREATE FUNCTION
> CREATE TRIGGER ti AFTER INSERT ON p REFERENCING NEW TABLE AS newt FOR EACH STATEMENT EXECUTE FUNCTION cnt();
CREATE TRIGGER
> CREATE TRIGGER tu AFTER UPDATE ON p REFERENCING OLD TABLE AS oldt NEW TABLE AS newt FOR EACH STATEMENT EXECUTE FUNCTION cnt();
CREATE TRIGGER
> CREATE TRIGGER td AFTER DELETE ON p REFERENCING OLD TABLE AS oldt FOR EACH STATEMENT EXECUTE FUNCTION cnt();
CREATE TRIGGER
