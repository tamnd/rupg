> CREATE TABLE lo (k int, f char(1))
CREATE TABLE
> INSERT INTO lo SELECT i, CASE WHEN i % 3 = 0 THEN 'O' ELSE 'F' END FROM generate_series(1, 3300) i
INSERT 0 3300
> CREATE TABLE ll (o int, s int, x date, y date)
CREATE TABLE
> INSERT INTO ll SELECT CASE WHEN i % 17 = 0 THEN NULL ELSE i / 3 END, CASE WHEN i % 19 = 0 THEN NULL ELSE (i * 7) % 200 END, date '2000-01-01' + (i * 5) % 50, date '2000-01-01' + (i * 3) % 50 FROM generate_series(1, 9000) i
INSERT 0 9000
> CREATE TABLE ls (s int, n int, name text)
CREATE TABLE
> INSERT INTO ls SELECT i, i % 7, 'S' || lpad(i::text, 3, '0') FROM generate_series(0, 199) i
