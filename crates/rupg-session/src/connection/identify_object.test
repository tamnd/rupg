> SET TimeZone = 'UTC';
SET
> CREATE SCHEMA s;
CREATE SCHEMA
> CREATE TABLE t (a int PRIMARY KEY, b text DEFAULT 'x' CHECK (b <> ''), "Weird Col" int);
CREATE TABLE
> CREATE TABLE s.u (a int);
CREATE TABLE
> CREATE VIEW v AS SELECT a FROM t;
CREATE VIEW
> CREATE SEQUENCE sq;
CREATE SEQUENCE
> CREATE INDEX ti ON t (b);
CREATE INDEX
> CREATE TYPE ct AS (x int, y text);
CREATE TYPE
> CREATE TYPE en AS ENUM ('a', 'b');
CREATE TYPE
> CREATE DOMAIN dm AS int CONSTRAINT dpos CHECK (VALUE > 0);
CREATE DOMAIN
> CREATE RULE r1 AS ON INSERT TO s.u DO INSTEAD NOTHING;
CREATE RULE
> CREATE TABLE "Mixed" (a int);
CREATE TABLE
> CREATE TABLE s.w (id int REFERENCES t);
CREATE TABLE
> CREATE FUNCTION s.f(int, text) RETURNS int LANGUAGE sql AS 'SELECT 1';
CREATE FUNCTION
> CREATE FUNCTION tf() RETURNS trigger LANGUAGE plpgsql AS 'BEGIN RETURN NEW; END';
CREATE FUNCTION
> CREATE TRIGGER trg BEFORE INSERT ON t FOR EACH ROW EXECUTE FUNCTION tf();
