SELECT 1
> SELECT pg_get_viewdef('w3')
fields pg_get_viewdef:25:-1:-1
row  SELECT ROW(5, 'z'::text)::c AS r,
    ROW(1, 'x'::text)::c AS s,
    (ROW(1, 2))::text AS t,
    (ROW(2, 'y'::text)::c).b AS u,
    COALESCE(NULL::c, ROW(3, 'q'::text)::c) AS v;
SELECT 1
