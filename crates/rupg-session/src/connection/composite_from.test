> CREATE VIEW w3 AS SELECT CAST(ROW(5, 'z') AS c) AS r, ROW(1, 'x')::c AS s, ROW(1, 2)::text AS t, (ROW(2, 'y')::c).b AS u, COALESCE(NULL, ROW(3, 'q')::c) AS v
CREATE VIEW
> SELECT r::text, s::text, t, u, v::text FROM w3
