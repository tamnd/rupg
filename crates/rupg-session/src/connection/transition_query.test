> create table wt1 (a int)
CREATE TABLE
> create table wt2 (a text)
CREATE TABLE
> create function wt_dump() returns trigger language plpgsql as $$ begin raise notice 'trigger = %, new table = %', TG_NAME, (select string_agg(new_table::text, ', ' order by a) from new_table); return null; end; $$
CREATE FUNCTION
> create function wt_before() returns trigger language plpgsql as $$ begin raise notice 'before % on %', TG_OP, TG_TABLE_NAME; return null; end; $$
CREATE FUNCTION
> create trigger wt1_b before insert on wt1 for each statement execute procedure wt_before()
CREATE TRIGGER
> create trigger wt1_t after insert on wt1 referencing new table as new_table for each statement execute procedure wt_dump()
CREATE TRIGGER
> create trigger wt2_t after insert on wt2 referencing new table as new_table for each statement execute procedure wt_dump()
CREATE TRIGGER
