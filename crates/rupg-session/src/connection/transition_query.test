> create table rt (a int primary key, b text)
CREATE TABLE
> create table tt (a int, b text, foreign key (a) references rt on update cascade on delete cascade)
CREATE TABLE
> create function tt_before() returns trigger language plpgsql as $$ begin raise notice 'before % on %', TG_OP, TG_TABLE_NAME; return null; end; $$
CREATE FUNCTION
> create trigger tt_b before insert or update or delete on tt for each statement execute procedure tt_before()
CREATE TRIGGER
> create function tt_del() returns trigger language plpgsql as $$ begin raise notice 'trigger = %, old table = %', TG_NAME, (select string_agg(old_table::text, ', ' order by a) from old_table); return null; end; $$
CREATE FUNCTION
> create trigger tt_d after delete on tt referencing old table as old_table for each statement execute procedure tt_del()
CREATE TRIGGER
> create function tt_upd() returns trigger language plpgsql as $$ begin raise notice 'trigger = %, old table = %, new table = %', TG_NAME, (select string_agg(old_table::text, ', ' order by a) from old_table), (select string_agg(new_table::text, ', ' order by a) from new_table); return null; end; $$
CREATE FUNCTION
> create trigger tt_u after update on tt referencing old table as old_table new table as new_table for each statement execute procedure tt_upd()
CREATE TRIGGER
