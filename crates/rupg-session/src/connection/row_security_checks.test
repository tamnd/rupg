!details
> SET TimeZone = 'UTC'
SET
> CREATE ROLE regress_ck_u;
CREATE ROLE
> CREATE TABLE ck_t (a int PRIMARY KEY, b text, c text);
CREATE TABLE
> ALTER TABLE ck_t ENABLE ROW LEVEL SECURITY;
ALTER TABLE
> GRANT SELECT, INSERT, UPDATE, DELETE, TRUNCATE ON ck_t TO public;
GRANT
> CREATE FUNCTION ck_fn(text, record) RETURNS bool AS $$ BEGIN RAISE NOTICE '%.%', $1, $2; RETURN true; END; $$ LANGUAGE plpgsql;
CREATE FUNCTION
> CREATE FUNCTION ck_set_c() RETURNS trigger AS $$ BEGIN new.c = upper(new.b); RETURN new; END; $$ LANGUAGE plpgsql;
CREATE FUNCTION
> CREATE TRIGGER ck_set_c BEFORE INSERT OR UPDATE ON ck_t FOR EACH ROW EXECUTE FUNCTION ck_set_c();
CREATE TRIGGER
> CREATE POLICY sel_pol ON ck_t FOR SELECT USING (ck_fn('SELECT USING', ck_t));
CREATE POLICY
> CREATE POLICY ins_pol ON ck_t FOR INSERT WITH CHECK (ck_fn('INSERT CHECK', ck_t));
CREATE POLICY
> CREATE POLICY upd_pol ON ck_t FOR UPDATE USING (ck_fn('UPDATE USING', ck_t)) WITH CHECK (ck_fn('UPDATE CHECK', ck_t));
CREATE POLICY
> CREATE POLICY del_pol ON ck_t FOR DELETE USING (ck_fn('DELETE USING', ck_t));
CREATE POLICY
> SET SESSION AUTHORIZATION regress_ck_u;
SET
session_authorization=regress_ck_u
is_superuser=off
