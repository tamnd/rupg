> create table tenk1 (unique1 int, two int, four int, ten int)
CREATE TABLE
> insert into tenk1 select g, g%2, g%4, g%10 from generate_series(0,999) g
INSERT 0 1000
> analyze tenk1
ANALYZE
> create table int8_tbl (q1 int8, q2 int8)
CREATE TABLE
> insert into int8_tbl values (123, 456), (123, 4567890123456789), (4567890123456789, 123), (4567890123456789, 4567890123456789), (4567890123456789, -4567890123456789)
INSERT 0 5
> analyze int8_tbl
ANALYZE
