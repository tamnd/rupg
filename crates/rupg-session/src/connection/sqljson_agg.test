> CREATE VIEW v2 AS SELECT a, JSON_OBJECTAGG(k : v) OVER (PARTITION BY g) AS c1, JSON_ARRAYAGG(a RETURNING jsonb) OVER w AS c2, JSON_ARRAYAGG(v NULL ON NULL) FILTER (WHERE a > 1) OVER w AS c3 FROM t WINDOW w AS (ORDER BY a)
CREATE VIEW
> SELECT pg_get_viewdef('v2'::regclass)
fields pg_get_viewdef:25:-1:-1
row  SELECT a,
    JSON_OBJECTAGG(k : v RETURNING json) OVER (PARTITION BY g) AS c1,
    JSON_ARRAYAGG(a RETURNING jsonb) OVER w AS c2,
    JSON_ARRAYAGG(v NULL ON NULL RETURNING json) FILTER (WHERE (a > 1)) OVER w AS c3
   FROM t
  WINDOW w AS (ORDER BY a);
