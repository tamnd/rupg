> CREATE VIEW v3 AS SELECT a, JSON_ARRAY(SELECT x.a FROM t AS x WHERE x.g = t.g ORDER BY x.a) AS c1, JSON_ARRAY(SELECT j FROM t ORDER BY a FORMAT JSON RETURNING jsonb) AS c2, JSON_ARRAY(SELECT k FROM t AS q WHERE false RETURNING varchar(9)) AS c3 FROM t
CREATE VIEW
> SELECT pg_get_viewdef('v3'::regclass)
fields pg_get_viewdef:25:-1:-1
row  SELECT a,
    JSON_ARRAY( SELECT x.a
           FROM t x
          WHERE (x.g = t.g)
          ORDER BY x.a RETURNING json) AS c1,
    JSON_ARRAY( SELECT t_1.j
           FROM t t_1
          ORDER BY t_1.a FORMAT JSON RETURNING jsonb) AS c2,
    JSON_ARRAY( SELECT q.k
           FROM t q
          WHERE false RETURNING character varying(9)) AS c3
   FROM t;
SELECT 1
