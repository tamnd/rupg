> CREATE VIEW v1 AS SELECT JSON_OBJECTAGG(k : v) AS c1, JSON_OBJECTAGG(k : v ABSENT ON NULL WITH UNIQUE KEYS RETURNING jsonb) AS c2, JSON_OBJECTAGG(k : j FORMAT JSON RETURNING text) FILTER (WHERE a > 1) AS c3, JSON_ARRAYAGG(v) AS c4, JSON_ARRAYAGG(v ORDER BY a DESC NULL ON NULL RETURNING jsonb) AS c5, JSON_ARRAYAGG(j FORMAT JSON) FILTER (WHERE a < 4) AS c6 FROM t WHERE a < 4
CREATE VIEW
> SELECT pg_get_viewdef('v1'::regclass)
fields pg_get_viewdef:25:-1:-1
row  SELECT JSON_OBJECTAGG(k : v RETURNING json) AS c1,
    JSON_OBJECTAGG(k : v ABSENT ON NULL WITH UNIQUE KEYS RETURNING jsonb) AS c2,
    JSON_OBJECTAGG(k : j FORMAT JSON RETURNING text) FILTER (WHERE (a > 1)) AS c3,
    JSON_ARRAYAGG(v RETURNING json) AS c4,
    JSON_ARRAYAGG(v ORDER BY a DESC NULL ON NULL RETURNING jsonb) AS c5,
    JSON_ARRAYAGG(j FORMAT JSON RETURNING json) FILTER (WHERE (a < 4)) AS c6
   FROM t
  WHERE (a < 4);
SELECT 1
> SELECT c2, c5 FROM v1
fields c2@v1.2:3802:-1:-1,c5@v1.5:3802:-1:-1
