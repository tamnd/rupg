> CREATE PROCEDURE p7() LANGUAGE plpgsql AS $$ BEGIN PERFORM set_config('transaction_read_only', 'on', true); COMMIT AND CHAIN; RAISE NOTICE 'ro %', current_setting('transaction_read_only'); COMMIT; RAISE NOTICE 'ro %', current_setting('transaction_read_only'); ROLLBACK AND CHAIN; END $$;
