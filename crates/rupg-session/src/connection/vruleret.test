> SELECT rulename, pg_get_ruledef(oid) FROM pg_rewrite WHERE ev_class = 'v'::regclass AND rulename <> '_RETURN' ORDER BY 1;
fields rulename@pg_rewrite.2:19:64:-1,pg_get_ruledef:25:-1:-1
row vd,CREATE RULE vd AS
    ON DELETE TO vrr.v DO INSTEAD  DELETE FROM t
  WHERE (t.id = old.id)
  RETURNING t.id,
    upper(t.val) AS upper;
row vi,CREATE RULE vi AS
    ON INSERT TO vrr.v DO INSTEAD  INSERT INTO t (id, val, n)
  VALUES (new.id, new.val, 1)
  RETURNING t.id,
    t.val;
row vu,CREATE RULE vu AS
    ON UPDATE TO vrr.v DO INSTEAD  UPDATE t SET val = new.val
  WHERE (t.id = old.id)
  RETURNING t.id,
    (t.val || '!'::text) AS "?column?";
SELECT 3
> CREATE VIEW w AS SELECT id, val FROM t;
CREATE VIEW
> CREATE RULE wi AS ON INSERT TO w DO INSTEAD INSERT INTO t VALUES (new.id, new.val);
CREATE RULE
> INSERT INTO w VALUES (6, 'f') RETURNING *;
ERROR 0A000 cannot perform INSERT RETURNING on relation "w"
HINT You need an unconditional ON INSERT DO INSTEAD rule with a RETURNING clause.
> INSERT INTO w VALUES (6, 'f');
INSERT 0 1
> CREATE RULE w1 AS ON UPDATE TO w DO INSTEAD (UPDATE t SET val = new.val RETURNING id, val; UPDATE t SET val = new.val RETURNING id, val);
ERROR 0A000 cannot have multiple RETURNING lists in a rule
> CREATE RULE w2 AS ON UPDATE TO w WHERE old.id > 0 DO INSTEAD UPDATE t SET val = new.val RETURNING id, val;
ERROR 0A000 RETURNING lists are not supported in conditional rules
> CREATE RULE w3 AS ON UPDATE TO w DO ALSO UPDATE t SET val = new.val RETURNING id, val;
ERROR 0A000 RETURNING lists are not supported in non-INSTEAD rules
> CREATE RULE w4 AS ON UPDATE TO w DO INSTEAD UPDATE t SET val = new.val RETURNING id, val, n;
ERROR 42P17 RETURNING list has too many entries
> CREATE RULE w5 AS ON UPDATE TO w DO INSTEAD UPDATE t SET val = new.val RETURNING id;
ERROR 42P17 RETURNING list has too few entries
> CREATE RULE w6 AS ON UPDATE TO w DO INSTEAD UPDATE t SET val = new.val RETURNING val, id;
ERROR 42P17 RETURNING list's entry 1 has different type from column "id"
DETAIL RETURNING list entry has type text, but column has type integer.
> CREATE RULE w7 AS ON UPDATE TO w DO INSTEAD UPDATE t SET val = new.val RETURNING n::int, val;
CREATE RULE
