> CREATE TABLE t (id int, val text, n numeric(6,2));
CREATE TABLE
> CREATE VIEW v AS SELECT id, val FROM t;
CREATE VIEW
> CREATE RULE vi AS ON INSERT TO v DO INSTEAD INSERT INTO t VALUES (new.id, new.val, 1) RETURNING t.id, t.val;
CREATE RULE
> CREATE RULE vu AS ON UPDATE TO v DO INSTEAD UPDATE t SET val = new.val WHERE t.id = old.id RETURNING t.id, t.val || '!';
CREATE RULE
> CREATE RULE vd AS ON DELETE TO v DO INSTEAD DELETE FROM t WHERE t.id = old.id RETURNING t.id, upper(t.val);
CREATE RULE
