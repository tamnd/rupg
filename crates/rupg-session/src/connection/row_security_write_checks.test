> CREATE FUNCTION rls_trig() RETURNS trigger LANGUAGE plpgsql AS 'BEGIN IF NEW.b = ''fix'' THEN NEW.b := ''ok''; END IF; RETURN NEW; END';
CREATE FUNCTION
> CREATE TRIGGER t3b BEFORE INSERT OR UPDATE ON rls_t3 FOR EACH ROW EXECUTE FUNCTION rls_trig();
