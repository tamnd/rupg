> create function f_drop() returns event_trigger language plpgsql as $$ declare r record; begin for r in select * from pg_event_trigger_dropped_objects() loop raise notice '% % % %', r.object_type, r.object_identity, r.original, r.normal; end loop; end $$
CREATE FUNCTION
> create event trigger e_drop on sql_drop execute procedure f_drop()
