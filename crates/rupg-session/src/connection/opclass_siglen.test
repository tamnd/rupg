> CREATE TABLE tsv (t text, a tsvector, b tsvector)
CREATE TABLE
> INSERT INTO tsv SELECT 'r' || i, to_tsvector('simple', 'w' || (i % 7) || ' x' || (i % 11)), to_tsvector('simple', 'y' || (i % 5)) FROM generate_series(1, 200) i
INSERT 0 200
