> explain (verbose, costs off) select g.c from gq g, gq g2 where g.a = g2.a + 1 and g.b = g2.b
fields QUERY PLAN:25:-1:-1
row Merge Join
row   Output: g.c
row   Merge Cond: ((g.a = ((g2.a + 1))) AND (g.b = g2.b))
row   ->  Sort
row         Output: g.c, g.a, g.b
row         Sort Key: g.a, g.b
row         ->  Seq Scan on public.gq g
row               Output: g.c, g.a, g.b
row   ->  Sort
row         Output: g2.a, g2.b, ((g2.a + 1))
row         Sort Key: ((g2.a + 1)), g2.b
row         ->  Seq Scan on public.gq g2
row               Output: g2.a, g2.b, (g2.a + 1)
EXPLAIN
