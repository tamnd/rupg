> create table gq (a int, b int, c int)
CREATE TABLE
> insert into gq values (1, 1, 10), (1, 2, 20), (2, 1, 30), (0, 1, 40)
INSERT 0 4
> explain (verbose, costs off) select sum(c), b + 1 from gq group by a, b + 1
fields QUERY PLAN:25:-1:-1
row HashAggregate
row   Output: sum(c), ((b + 1)), a
row   Group Key: gq.a, (gq.b + 1)
row   ->  Seq Scan on public.gq
row         Output: (b + 1), a, c
EXPLAIN
