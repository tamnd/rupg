> explain (verbose, costs off) select c from gq where (a, b) in (select a + 1, b from gq)
fields QUERY PLAN:25:-1:-1
row Hash Join
row   Output: gq.c
row   Inner Unique: true
row   Hash Cond: ((gq.a = (gq_1.a + 1)) AND (gq.b = gq_1.b))
row   ->  Seq Scan on public.gq
row         Output: gq.a, gq.b, gq.c
row   ->  Hash
row         Output: gq_1.a, gq_1.b
row         ->  HashAggregate
row               Output: gq_1.a, gq_1.b
row               Group Key: (gq_1.a + 1), gq_1.b
row               ->  Seq Scan on public.gq gq_1
row                     Output: gq_1.a, gq_1.b, (gq_1.a + 1)
EXPLAIN
