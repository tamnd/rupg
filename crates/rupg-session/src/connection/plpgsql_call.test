ERROR 42601 procedure parameter "x" is an output parameter but corresponding argument is not writable (PL/pgSQL function inline_code_block line 1 at CALL)
> CREATE PROCEDURE p_def(INOUT a int, b int DEFAULT 100) LANGUAGE plpgsql AS $$
>> BEGIN
>>   a := a + b;
>> END $$;
CREATE PROCEDURE
> DO $$ DECLARE v int := 1; BEGIN CALL p_def(v); RAISE NOTICE 'v=%', v; END $$;
NOTICE 00000 v=101 (PL/pgSQL function inline_code_block line 1 at RAISE)
DO
> CREATE PROCEDURE p_sql(INOUT a int) LANGUAGE sql AS $$ SELECT a * 7 $$;
CREATE PROCEDURE
> DO $$ DECLARE v int := 3; BEGIN CALL p_sql(v); RAISE NOTICE 'v=%', v; END $$;
NOTICE 00000 v=21 (PL/pgSQL function inline_code_block line 1 at RAISE)
DO
> DO $$ DECLARE v int := 1; BEGIN CALL p_inc(v); GET DIAGNOSTICS v = ROW_COUNT; RAISE NOTICE 'rc=%', v; END $$;
NOTICE 00000 rc=0 (PL/pgSQL function inline_code_block line 1 at RAISE)
