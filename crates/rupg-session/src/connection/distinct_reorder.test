> create table dot (x int, y int, z int)
CREATE TABLE
> insert into dot select i%10, i%10, i%10 from generate_series(1, 1000) as i
INSERT 0 1000
> create index dot_x_y on dot (x, y)
CREATE INDEX
> analyze dot
