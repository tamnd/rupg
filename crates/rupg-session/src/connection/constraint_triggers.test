> CREATE TABLE ct_a (i int);
CREATE TABLE
> CREATE TABLE ct_ref (j int);
CREATE TABLE
> CREATE FUNCTION ct_f() RETURNS trigger LANGUAGE plpgsql AS $$
>> BEGIN
>>   RAISE NOTICE '% % %: % depth %', tg_name, tg_op, tg_argv[0], coalesce(new.i, old.i), pg_trigger_depth();
>>   IF coalesce(new.i, old.i) < 0 THEN
>>     RAISE EXCEPTION 'bad row %', coalesce(new.i, old.i);
>>   END IF;
>>   RETURN NULL;
>> END $$;
CREATE FUNCTION
> CREATE CONSTRAINT TRIGGER ct_imm AFTER INSERT ON ct_a FOR EACH ROW EXECUTE FUNCTION ct_f('imm');
CREATE TRIGGER
> CREATE CONSTRAINT TRIGGER ct_def AFTER INSERT OR UPDATE ON ct_a DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION ct_f('def');
CREATE TRIGGER
> CREATE CONSTRAINT TRIGGER ct_dim AFTER DELETE ON ct_a FROM ct_ref DEFERRABLE INITIALLY IMMEDIATE FOR EACH ROW WHEN (old.i > 1) EXECUTE FUNCTION ct_f('dim');
