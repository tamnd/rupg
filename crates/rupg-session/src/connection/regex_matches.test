> CREATE VIEW rxw AS SELECT regexp_replace(s, 'b', 'X', 'g') AS a, regexp_count(s, 'b') AS b, regexp_instr(s, 'c', 1, 1, 1) AS c, regexp_substr(s, '.c') AS d, regexp_split_to_array(s, '') AS e, regexp_replace(s, 'b', 'Y', 1, 0) AS f FROM (VALUES ('abcbc')) AS t(s)
CREATE VIEW
> SELECT pg_get_viewdef('rxw'::regclass, true)
fields pg_get_viewdef:25:-1:-1
row  SELECT regexp_replace(s, 'b'::text, 'X'::text, 'g'::text) AS a,
    regexp_count(s, 'b'::text) AS b,
    regexp_instr(s, 'c'::text, 1, 1, 1) AS c,
    regexp_substr(s, '.c'::text) AS d,
    regexp_split_to_array(s, ''::text) AS e,
    regexp_replace(s, 'b'::text, 'Y'::text, 1, 0) AS f
   FROM ( VALUES ('abcbc'::text)) t(s);
