> CREATE VIEW wf_v AS SELECT p, sum(v) OVER (PARTITION BY p ORDER BY o ROWS BETWEEN 1 PRECEDING AND 2 FOLLOWING EXCLUDE CURRENT ROW) AS a, sum(v) OVER (ORDER BY o RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS b, sum(v) OVER (ORDER BY n RANGE BETWEEN 1.5 PRECEDING AND UNBOUNDED FOLLOWING EXCLUDE TIES) AS c, count(*) OVER (ORDER BY o GROUPS 2 PRECEDING EXCLUDE GROUP) AS e, first_value(v) OVER (ORDER BY d RANGE BETWEEN interval '1 day' FOLLOWING AND interval '3 days' FOLLOWING) AS f, sum(v) OVER (ROWS UNBOUNDED PRECEDING) AS h FROM wf_t
CREATE VIEW
> SELECT pg_get_viewdef('wf_v'::regclass)
fields pg_get_viewdef:25:-1:-1
row  SELECT p,
    sum(v) OVER (PARTITION BY p ORDER BY o ROWS BETWEEN 1 PRECEDING AND 2 FOLLOWING EXCLUDE CURRENT ROW) AS a,
    sum(v) OVER (ORDER BY o RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS b,
    sum(v) OVER (ORDER BY n RANGE BETWEEN 1.5 PRECEDING AND UNBOUNDED FOLLOWING EXCLUDE TIES) AS c,
    count(*) OVER (ORDER BY o GROUPS 2 PRECEDING EXCLUDE GROUP) AS e,
    first_value(v) OVER (ORDER BY d RANGE BETWEEN '1 day'::interval FOLLOWING AND '3 days'::interval FOLLOWING) AS f,
    sum(v) OVER (ROWS UNBOUNDED PRECEDING) AS h
   FROM wf_t;
