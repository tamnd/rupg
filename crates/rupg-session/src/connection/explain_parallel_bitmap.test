> create table bt1 (unique1 int, hundred int, thousand int, ten int, pad text)
CREATE TABLE
> insert into bt1 select i, i % 100, i % 1000, i % 10, repeat('x', 100) from generate_series(0, 9999) i
INSERT 0 10000
> create index bt1_hundred on bt1 (hundred)
CREATE INDEX
> create index bt1_thousand on bt1 (thousand)
CREATE INDEX
> create table bt2 (unique1 int, thousand int)
CREATE TABLE
> insert into bt2 select i, i % 1000 from generate_series(0, 9999) i
INSERT 0 10000
