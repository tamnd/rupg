row r1,CREATE RULE r1 AS
    ON UPDATE TO vrs.src DO  INSERT INTO log (f1, f2, tag, id) VALUES (old.f1,old.f2,'old'::text,DEFAULT), (new.f1,new.f2,'new'::text,DEFAULT);
row r3,CREATE RULE r3 AS
    ON INSERT TO vrs.src DO  INSERT INTO log (f1, f2, tag, id) VALUES (NULL::integer,NULL::integer,'-'::text,DEFAULT), (new.f1,new.f2,'new'::text,DEFAULT);
row r4,CREATE RULE r4 AS
    ON DELETE TO vrs.src DO  INSERT INTO log (f1, f2)
  VALUES (old.f1, old.f2);
