> CREATE RULE xr_also AS ON INSERT TO xr_t DO ALSO INSERT INTO xr_log VALUES (NEW.a);
CREATE RULE
> CREATE RULE xr_upd AS ON UPDATE TO xr_t DO INSTEAD (INSERT INTO xr_log VALUES (OLD.a); UPDATE xr_log SET a = NEW.a WHERE a = OLD.a);
CREATE RULE
> CREATE RULE xr_del AS ON DELETE TO xr_n DO INSTEAD NOTHING;
