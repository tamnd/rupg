> CREATE TABLE hat_data (hat_name char(10), hat_color char(10));
CREATE TABLE
> CREATE UNIQUE INDEX hat_data_unique_idx ON hat_data (hat_name COLLATE "C" bpchar_pattern_ops);
CREATE INDEX
> CREATE TABLE hats (hat_name char(10) primary key, hat_color char(10));
CREATE TABLE
> CREATE RULE hat_upsert AS ON INSERT TO hats DO INSTEAD INSERT INTO hat_data VALUES (NEW.hat_name, NEW.hat_color) ON CONFLICT (hat_name COLLATE "C" bpchar_pattern_ops) DO UPDATE SET hat_name = hat_data.hat_name, hat_color = excluded.hat_color WHERE excluded.hat_color <> 'forbidden' AND hat_data.* != excluded.* RETURNING *;
CREATE RULE
