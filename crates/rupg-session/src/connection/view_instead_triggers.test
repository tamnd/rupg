!details
> SET TimeZone = 'UTC'
SET
> CREATE TABLE base (id int PRIMARY KEY, name text, qty int);
CREATE TABLE
> INSERT INTO base VALUES (1, 'a', 10), (2, 'b', 20), (3, 'c', 30);
INSERT 0 3
> CREATE VIEW bv AS SELECT id, name, qty * 2 AS dbl FROM base;
CREATE VIEW
> CREATE FUNCTION bv_ins() RETURNS trigger LANGUAGE plpgsql AS $$
>> BEGIN
>>   RAISE NOTICE '% % % on %: new=%', TG_WHEN, TG_LEVEL, TG_OP, TG_TABLE_NAME, NEW;
>>   IF NEW.id < 0 THEN RETURN NULL; END IF;
>>   INSERT INTO base VALUES (NEW.id, NEW.name, NEW.dbl / 2);
>>   NEW.name := upper(NEW.name);
>>   RETURN NEW;
>> END $$;
CREATE FUNCTION
> CREATE FUNCTION bv_upd() RETURNS trigger LANGUAGE plpgsql AS $$
>> BEGIN
>>   RAISE NOTICE '% % % on %: old=% new=%', TG_WHEN, TG_LEVEL, TG_OP, TG_TABLE_NAME, OLD, NEW;
>>   IF NEW.name = 'skip' THEN RETURN NULL; END IF;
>>   UPDATE base SET name = NEW.name, qty = NEW.dbl / 2 WHERE id = OLD.id;
>>   RETURN NEW;
>> END $$;
CREATE FUNCTION
> CREATE FUNCTION bv_del() RETURNS trigger LANGUAGE plpgsql AS $$
>> BEGIN
>>   RAISE NOTICE '% % % on %: old=%', TG_WHEN, TG_LEVEL, TG_OP, TG_TABLE_NAME, OLD;
>>   IF OLD.id = 2 THEN RETURN NULL; END IF;
>>   DELETE FROM base WHERE id = OLD.id;
>>   RETURN OLD;
>> END $$;
CREATE FUNCTION
> CREATE FUNCTION bv_stmt() RETURNS trigger LANGUAGE plpgsql AS $$
>> BEGIN
>>   RAISE NOTICE '% % % on %', TG_WHEN, TG_LEVEL, TG_OP, TG_TABLE_NAME;
>>   RETURN NULL;
>> END $$;
CREATE FUNCTION
> CREATE TRIGGER bv_ins INSTEAD OF INSERT ON bv FOR EACH ROW EXECUTE FUNCTION bv_ins();
CREATE TRIGGER
> CREATE TRIGGER bv_upd INSTEAD OF UPDATE ON bv FOR EACH ROW EXECUTE FUNCTION bv_upd();
CREATE TRIGGER
> CREATE TRIGGER bv_del INSTEAD OF DELETE ON bv FOR EACH ROW EXECUTE FUNCTION bv_del();
CREATE TRIGGER
> CREATE TRIGGER bv_bs BEFORE INSERT OR UPDATE OR DELETE ON bv FOR EACH STATEMENT EXECUTE FUNCTION bv_stmt();
CREATE TRIGGER
> CREATE TRIGGER bv_as AFTER INSERT OR UPDATE OR DELETE ON bv FOR EACH STATEMENT EXECUTE FUNCTION bv_stmt();
CREATE TRIGGER
