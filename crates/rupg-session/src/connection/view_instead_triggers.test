> CREATE FUNCTION two() RETURNS trigger LANGUAGE plpgsql AS $$
>> BEGIN
>>   RAISE NOTICE 'two: %', NEW;
>>   NEW.name := NEW.name || '2';
>>   RETURN NEW;
>> END $$;
