!details
> SET TimeZone = 'UTC'
SET
> CREATE TABLE ps (a int, b text, c bool, d int, e float8);
CREATE TABLE
> INSERT INTO ps SELECT x, 'v' || (x % 10), CASE WHEN x % 10 = 0 THEN NULL ELSE x % 10 < 7 END, CASE WHEN x <= 5000 THEN x % 50 ELSE x END, CASE WHEN x % 5 = 0 THEN NULL ELSE x * 1.5 END FROM generate_series(1, 10000) x;
INSERT 0 10000
> ANALYZE ps;
ANALYZE
