> create table tk (unique1 int, ten int, fivethous int)
CREATE TABLE
> insert into tk select g, g % 10, g % 5000 from generate_series(0,9999) g
INSERT 0 10000
> analyze tk
ANALYZE
> explain (verbose, costs off) select t1.ten, sum(x) from tk t1 left join lateral (select t1.ten + t2.ten as x, t2.fivethous from tk t2) ss on t1.unique1 = ss.fivethous group by t1.ten order by t1.ten
