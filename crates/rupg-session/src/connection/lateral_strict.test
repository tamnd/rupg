row               Output: t1.ten, t2.ten
row               Hash Cond: (t2.fivethous = t1.unique1)
row               ->  Seq Scan on public.tk t2
row                     Output: t2.unique1, t2.ten, t2.fivethous
row               ->  Hash
row                     Output: t1.ten, t1.unique1
