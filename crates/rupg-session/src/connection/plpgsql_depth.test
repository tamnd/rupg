> CREATE FUNCTION pd_gen(n integer) RETURNS void LANGUAGE plpgsql AS $$ BEGIN IF n <= 0 THEN UPDATE pd_subxids SET val = 1 WHERE subx = 0; RETURN; ELSE PERFORM pd_gen(n - 1); RETURN; END IF; EXCEPTION WHEN raise_exception THEN NULL; END $$
CREATE FUNCTION
