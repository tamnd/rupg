> create function pst() returns int language plpgsql parallel safe as $$ begin return 1; end $$
CREATE FUNCTION
> create function pre() returns int language plpgsql parallel restricted as $$ begin return 1; end $$
CREATE FUNCTION
> create function pun() returns int language plpgsql as $$ begin return 1; end $$
CREATE FUNCTION
> create table t(a int, b text)
CREATE TABLE
> insert into t select g, g::text from generate_series(1, 10) g
INSERT 0 10
> create temp table tt(a int)
CREATE TABLE
> set debug_parallel_query = on
SET
> explain (verbose, costs off) select pst()
fields QUERY PLAN:25:-1:-1
row Gather
row   Output: (pst())
row   Workers Planned: 1
row   Single Copy: true
row   ->  Result
row         Output: pst()
EXPLAIN
> explain (verbose, costs off) select pre()
fields QUERY PLAN:25:-1:-1
row Result
row   Output: pre()
EXPLAIN
> explain (verbose, costs off) select pun()
fields QUERY PLAN:25:-1:-1
row Result
row   Output: pun()
EXPLAIN
> explain (costs off) select * from t where a = 1
fields QUERY PLAN:25:-1:-1
row Gather
row   Workers Planned: 1
row   Single Copy: true
row   ->  Seq Scan on t
row         Filter: (a = 1)
EXPLAIN
> explain (costs off) select * from tt
fields QUERY PLAN:25:-1:-1
row Seq Scan on tt
EXPLAIN
> explain (costs off) select (select 1)
fields QUERY PLAN:25:-1:-1
row Gather
row   Workers Planned: 1
row   Single Copy: true
row   InitPlan expr_1
row     ->  Result
row   ->  Result
EXPLAIN
> explain (verbose, costs off) select a, (select max(a) from t) from t
fields QUERY PLAN:25:-1:-1
row Gather
row   Output: t.a, ((InitPlan expr_1).col1)
row   Workers Planned: 1
row   Single Copy: true
row   InitPlan expr_1
row     ->  Aggregate
row           Output: max(t_1.a)
row           ->  Seq Scan on public.t t_1
row                 Output: t_1.a, t_1.b
row   ->  Seq Scan on public.t
row         Output: t.a, (InitPlan expr_1).col1
EXPLAIN
> explain (costs off) select * from t where a in (select a from t limit 3)
fields QUERY PLAN:25:-1:-1
row Hash Semi Join
row   Hash Cond: (t.a = t_1.a)
row   ->  Seq Scan on t
row   ->  Hash
row         ->  Limit
row               ->  Seq Scan on t t_1
EXPLAIN
> explain (costs off) with w as materialized (select * from t) select * from w
fields QUERY PLAN:25:-1:-1
row CTE Scan on w
row   CTE w
row     ->  Seq Scan on t
EXPLAIN
