> create table ta (unique1 int, unique2 int, two int, four int, hundred int, thousand int, twenty int, filler text)
CREATE TABLE
> insert into ta select i, (i * 7) % 10000, i % 2, i % 4, i % 100, i % 1000, i % 20, repeat(chr(97 + i % 26), 20) from generate_series(0, 9999) i
INSERT 0 10000
> create unique index ta_unique1 on ta (unique1)
CREATE INDEX
> create index ta_hundred on ta (hundred)
CREATE INDEX
> create table tb (unique1 int, unique2 int, two int, hundred int, thousand int, filler text)
CREATE TABLE
> insert into tb select i, (i * 3) % 10000, i % 2, i % 100, i % 1000, repeat(chr(97 + i % 26), 20) from generate_series(0, 9999) i
INSERT 0 10000
> create unique index tb_unique1 on tb (unique1)
CREATE INDEX
> create index tb_thousand on tb (thousand)
CREATE INDEX
> vacuum analyze ta
VACUUM
> vacuum analyze tb
