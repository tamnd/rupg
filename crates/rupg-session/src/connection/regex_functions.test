> CREATE VIEW rxv AS SELECT substring(s FROM 'b(.)') AS a, substring(s SIMILAR '%#"b#"%' ESCAPE '#') AS b, s SIMILAR TO 'a%' AS c, s NOT SIMILAR TO 'a%' ESCAPE '#' AS d, regexp_match(s, 'x', 'i') AS e, regexp_like(s, 'y') AS f FROM (VALUES ('abc')) AS t(s)
CREATE VIEW
> SELECT pg_get_viewdef('rxv'::regclass, true)
fields pg_get_viewdef:25:-1:-1
row  SELECT "substring"(s, 'b(.)'::text) AS a,
    SUBSTRING(s SIMILAR '%#"b#"%'::text ESCAPE '#'::text) AS b,
    s ~ similar_to_escape('a%'::text) AS c,
    s !~ similar_to_escape('a%'::text, '#'::text) AS d,
    regexp_match(s, 'x'::text, 'i'::text) AS e,
    regexp_like(s, 'y'::text) AS f
   FROM ( VALUES ('abc'::text)) t(s);
