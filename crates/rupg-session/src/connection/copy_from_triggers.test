> CREATE TABLE u (a int, b text);
CREATE TABLE
> CREATE FUNCTION dump() RETURNS trigger LANGUAGE plpgsql AS $$
>> BEGIN
>>   RAISE NOTICE '% %', TG_NAME, (SELECT string_agg(n::text, ', ' ORDER BY a) FROM n);
>>   RETURN NULL;
>> END $$;
CREATE FUNCTION
