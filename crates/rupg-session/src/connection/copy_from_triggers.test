> SET TimeZone = 'UTC'
SET
> CREATE TABLE t (a int PRIMARY KEY, b text CHECK (b <> 'bad'));
CREATE TABLE
> CREATE FUNCTION tf() RETURNS trigger LANGUAGE plpgsql AS $$
>> BEGIN
>>   IF TG_LEVEL = 'ROW' THEN
>>     RAISE NOTICE '% % % % %', TG_NAME, TG_WHEN, TG_LEVEL, TG_OP, new::text;
>>   ELSE
>>     RAISE NOTICE '% % % %', TG_NAME, TG_WHEN, TG_LEVEL, TG_OP;
>>   END IF;
>>   IF TG_LEVEL = 'ROW' AND TG_WHEN = 'BEFORE' THEN
>>     IF new.b = 'skip' THEN RETURN NULL; END IF;
>>     IF new.b = 'up' THEN new.b := 'UP'; END IF;
>>     IF new.b = 'mk' THEN new.b := 'bad'; END IF;
>>     IF new.b = 'boom' THEN RAISE EXCEPTION 'boom at %', new.a; END IF;
>>     RETURN new;
>>   END IF;
>>   RETURN NULL;
>> END $$;
CREATE FUNCTION
