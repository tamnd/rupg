> SET TimeZone = 'UTC'
SET
> CREATE SCHEMA fs;
CREATE SCHEMA
> CREATE TABLE fs.t (a int);
CREATE TABLE
> INSERT INTO fs.t VALUES (7);
INSERT 0 1
> CREATE FUNCTION f_path() RETURNS text LANGUAGE sql SET search_path = fs, public AS $$ SELECT current_setting('search_path') || ' ' || (SELECT a FROM t)::text $$;
CREATE FUNCTION
> SELECT f_path();
fields f_path:25:-1:-1
row fs, public 7
SELECT 1
> SHOW search_path;
fields search_path:25:-1:-1
row "$user", public
SHOW
> SELECT proconfig::text FROM pg_proc WHERE proname = 'f_path';
fields proconfig:25:-1:-1
row {"search_path=fs, public"}
SELECT 1
> SELECT pg_get_functiondef('f_path'::regproc);
fields pg_get_functiondef:25:-1:-1
row CREATE OR REPLACE FUNCTION public.f_path()
 RETURNS text
 LANGUAGE sql
 SET search_path TO 'fs', 'public'
AS $function$ SELECT current_setting('search_path') || ' ' || (SELECT a FROM t)::text $function$

SELECT 1
> CREATE FUNCTION f_mem() RETURNS text LANGUAGE plpgsql SET work_mem = '2MB' SET datestyle TO iso, mdy AS $$ BEGIN RETURN current_setting('work_mem') || ' ' || current_setting('datestyle'); END $$;
CREATE FUNCTION
> SELECT f_mem(), current_setting('work_mem');
fields f_mem:25:-1:-1,current_setting:25:-1:-1
row 2MB ISO, MDY,4MB
SELECT 1
> SELECT proconfig::text FROM pg_proc WHERE proname = 'f_mem';
fields proconfig:25:-1:-1
row {work_mem=2MB,"DateStyle=iso, mdy"}
SELECT 1
> SELECT pg_get_functiondef('f_mem'::regproc);
fields pg_get_functiondef:25:-1:-1
row CREATE OR REPLACE FUNCTION public.f_mem()
 RETURNS text
 LANGUAGE plpgsql
 SET work_mem TO '2MB'
 SET "DateStyle" TO 'iso, mdy'
AS $function$ BEGIN RETURN current_setting('work_mem') || ' ' || current_setting('datestyle'); END $function$

SELECT 1
> CREATE FUNCTION f_inner() RETURNS text LANGUAGE plpgsql SET work_mem = '3MB' AS $$ BEGIN SET work_mem = '5MB'; SET LOCAL statement_timeout = '7s'; RETURN current_setting('work_mem'); END $$;
CREATE FUNCTION
> BEGIN;
BEGIN
> SELECT f_inner();
fields f_inner:25:-1:-1
row 5MB
SELECT 1
> SELECT current_setting('work_mem'), current_setting('statement_timeout');
fields current_setting:25:-1:-1,current_setting:25:-1:-1
row 5MB,7s
SELECT 1
> COMMIT;
COMMIT
> SHOW work_mem;
fields work_mem:25:-1:-1
row 5MB
SHOW
> RESET work_mem;
RESET
> CREATE FUNCTION f_local() RETURNS text LANGUAGE plpgsql SET work_mem = '3MB' AS $$ BEGIN SET LOCAL work_mem = '6MB'; RETURN current_setting('work_mem'); END $$;
