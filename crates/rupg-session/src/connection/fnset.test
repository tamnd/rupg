> CREATE FUNCTION f_err() RETURNS int LANGUAGE plpgsql SET work_mem = '3MB' AS $$ BEGIN RAISE EXCEPTION 'boom'; END $$;
CREATE FUNCTION
> SELECT f_err();
fields f_err:23:4:-1
ERROR P0001 boom (PL/pgSQL function f_err() line 1 at RAISE)
> SHOW work_mem;
fields work_mem:25:-1:-1
row 4MB
SHOW
> CREATE FUNCTION f_catch() RETURNS text LANGUAGE plpgsql AS $$ BEGIN BEGIN PERFORM f_err(); EXCEPTION WHEN OTHERS THEN NULL; END; RETURN current_setting('work_mem'); END $$;
CREATE FUNCTION
> SELECT f_catch();
fields f_catch:25:-1:-1
row 4MB
