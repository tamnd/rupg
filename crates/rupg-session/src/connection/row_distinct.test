> CREATE VIEW v1 AS SELECT (a, b) IS DISTINCT FROM (1, 'x') AS d, (a, b, a) IS NOT DISTINCT FROM (2, NULL, 2) AS n, ROW(a) IS DISTINCT FROM ROW(1) AS one, a IS DISTINCT FROM NULL AS dn, NULL IS NOT DISTINCT FROM b AS nn, a IS NOT DISTINCT FROM 1 AS s FROM t
CREATE VIEW
> SELECT pg_get_viewdef('v1')
fields pg_get_viewdef:25:-1:-1
row  SELECT ((a IS DISTINCT FROM 1) OR (b IS DISTINCT FROM 'x'::text)) AS d,
    (NOT (((a IS DISTINCT FROM 2) OR (b IS DISTINCT FROM NULL::text)) OR (a IS DISTINCT FROM 2))) AS n,
    (a IS DISTINCT FROM 1) AS one,
    (a IS NOT NULL) AS dn,
    (b IS NULL) AS nn,
    (NOT (a IS DISTINCT FROM 1)) AS s
   FROM t;
SELECT 1
