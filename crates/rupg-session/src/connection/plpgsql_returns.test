> CREATE FUNCTION pr_do() RETURNS int LANGUAGE plpgsql AS $$
>> DECLARE n int := 0;
>> BEGIN
>>   FOR i IN 1..3 LOOP
>>     BEGIN
>>       EXECUTE 'DO $d$ DECLARE x int = 0; BEGIN x := 1 / x; END $d$';
>>     EXCEPTION WHEN division_by_zero THEN
>>       n := n + 1;
>>     END;
>>   END LOOP;
>>   EXECUTE 'DO $d$ BEGIN RAISE NOTICE ''inner''; END $d$';
>>   RETURN n;
>> END $$;
CREATE FUNCTION
