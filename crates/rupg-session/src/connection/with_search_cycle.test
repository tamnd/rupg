> CREATE VIEW v_search AS with recursive search_graph(f, t, label) as (select * from graph0 g union all select g.* from graph0 g, search_graph sg where g.f = sg.t) search depth first by f, t set seq select f, t, label from search_graph
CREATE VIEW
> select pg_get_viewdef('v_search')
fields pg_get_viewdef:25:-1:-1
row  WITH RECURSIVE search_graph(f, t, label) AS (
         SELECT g.f,
            g.t,
            g.label
           FROM graph0 g
        UNION ALL
         SELECT g.f,
            g.t,
            g.label
           FROM graph0 g,
            search_graph sg
          WHERE (g.f = sg.t)
        ) SEARCH DEPTH FIRST BY f, t SET seq
 SELECT f,
    t,
    label
   FROM search_graph;
