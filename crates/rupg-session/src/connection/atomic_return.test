fields pg_get_functiondef:25:-1:-1
row CREATE OR REPLACE FUNCTION public.ra6(t integer)
 RETURNS bigint
 LANGUAGE sql
BEGIN ATOMIC
 RETURN ( SELECT count(*) AS count
            FROM pg_class
           WHERE (pg_class.oid < (ra6.t)::oid));
END

