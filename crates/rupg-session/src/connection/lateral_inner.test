> explain (verbose, costs off) select * from tk t1 join lateral generate_series(1, t1.ten) g on g = t1.unique1 where t1.unique1 < 3
fields QUERY PLAN:25:-1:-1
row Nested Loop
row   Output: t1.unique1, t1.ten, t1.fivethous, g.g
row   ->  Seq Scan on public.tk t1
row         Output: t1.unique1, t1.ten, t1.fivethous
row         Filter: (t1.unique1 < 3)
row   ->  Function Scan on pg_catalog.generate_series g
row         Output: g.g
row         Function Call: generate_series(1, t1.ten)
row         Filter: (t1.unique1 = g.g)
EXPLAIN
> explain (costs off) select * from tk t1 left join lateral (values (t1.ten), (t1.unique1)) v(a) on v.a = t1.fivethous where t1.unique1 < 3
fields QUERY PLAN:25:-1:-1
row Nested Loop Left Join
row   ->  Seq Scan on tk t1
row         Filter: (unique1 < 3)
row   ->  Values Scan on "*VALUES*"
row         Filter: (column1 = t1.fivethous)
EXPLAIN
