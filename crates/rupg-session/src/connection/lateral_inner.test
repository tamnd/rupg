> create table tk(unique1 int, ten int, fivethous int)
CREATE TABLE
> insert into tk select g, g%10, g%5000 from generate_series(0,9999) g
INSERT 0 10000
> analyze tk
ANALYZE
> explain (costs off) select t1.unique1, x from tk t1 join lateral (select t1.ten as x, t2.fivethous from tk t2 where t2.ten = t1.ten offset 0) ss on t1.unique1 = ss.fivethous + 9998 where t1.unique1 > 9996
fields QUERY PLAN:25:-1:-1
row Nested Loop
row   ->  Seq Scan on tk t1
row         Filter: (unique1 > 9996)
row   ->  Subquery Scan on ss
row         Filter: (t1.unique1 = (ss.fivethous + 9998))
row         ->  Seq Scan on tk t2
row               Filter: (ten = t1.ten)
EXPLAIN
> select t1.unique1, x from tk t1 join lateral (select t1.ten as x, t2.fivethous from tk t2 where t2.ten = t1.ten offset 0) ss on t1.unique1 = ss.fivethous + 9998 where t1.unique1 > 9996 order by 1, 2
fields unique1@tk.1:23:4:-1,x@tk.2:23:4:-1
SELECT 0
