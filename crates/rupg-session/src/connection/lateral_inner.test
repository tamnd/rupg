> select t1.unique1, x from tk t1 left join lateral (select t1.ten as x, t2.fivethous from tk t2 where t2.ten = t1.ten offset 0) ss on t1.unique1 = ss.fivethous + 9998 where t1.unique1 > 9996 order by 1, 2
