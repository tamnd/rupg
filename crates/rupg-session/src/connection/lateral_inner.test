> select * from tk t1 left join lateral generate_series(1, t1.ten) g on g = t1.unique1 where t1.unique1 < 3 order by 1
fields unique1@tk.1:23:4:-1,ten@tk.2:23:4:-1,fivethous@tk.3:23:4:-1,g:23:4:-1
row 0,0,0,NULL
row 1,1,1,1
row 2,2,2,2
