> CREATE VIEW v4 AS SELECT j IS JSON AS c1, j IS JSON OBJECT AS c2, j IS NOT JSON ARRAY WITH UNIQUE KEYS AS c3, j::json IS JSON SCALAR AS c4, (j IS JSON) = true AS c5, j::bytea IS JSON AS c6 FROM t WHERE a < 3
CREATE VIEW
> SELECT pg_get_viewdef('v4'::regclass)
fields pg_get_viewdef:25:-1:-1
row  SELECT (j IS JSON) AS c1,
    (j IS JSON OBJECT) AS c2,
    (NOT (j IS JSON ARRAY WITH UNIQUE KEYS)) AS c3,
    ((j)::json IS JSON SCALAR) AS c4,
    ((j IS JSON) = true) AS c5,
    ((j)::bytea IS JSON) AS c6
   FROM t
  WHERE (a < 3);
