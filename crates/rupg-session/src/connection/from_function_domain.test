!details
> create type fcc as (r float8, i float8)
CREATE TYPE
> create domain fcd as fcc check ((value).r > 0)
CREATE DOMAIN
> create function mkfcd(r float8, i float8) returns fcd as 'select row(r, i)' language sql
CREATE FUNCTION
> select mkfcd(1,2)::text
fields mkfcd:25:-1:-1
row (1,2)
SELECT 1
> select mkfcd(-1,2)::text
fields mkfcd:25:-1:-1
ERROR 23514 value for domain fcd violates check constraint "fcd_check"
