fields r:701:8:-1,i:701:8:-1
row 1,2
SELECT 1
> select m::text, m is not null, (m).i from mkfcd(1,2) m
fields m:25:-1:-1,?column?:16:1:-1,i:701:8:-1
row (1,2),t,2
SELECT 1
> select m.r from mkfcd(3,4) m
fields r:701:8:-1
row 3
SELECT 1
