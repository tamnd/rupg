> select * from rows from (mkfcd(1,2), mkfcd(5,6)) m
fields r:701:8:-1,i:701:8:-1,r:701:8:-1,i:701:8:-1
row 1,2,5,6
SELECT 1
> select pg_typeof(m) from mkfcd(1,2) m
fields pg_typeof:2206:4:-1
row fcd
