> CREATE FUNCTION fa(n int) RETURNS int[] LANGUAGE plpgsql AS $$ DECLARE x int[]; BEGIN FOR i IN 1..n LOOP x[i] := i * i; END LOOP; x[n + 2:n + 3] := ARRAY[-1, -2]; RETURN x; END $$;
CREATE FUNCTION
> SELECT fa(3), fa(0);
fields fa:1007:-1:-1,fa:1007:-1:-1
row {1,4,9,NULL,-1,-2},[2:3]={-1,-2}
