> CREATE FUNCTION logit() RETURNS trigger LANGUAGE plpgsql AS $$
>> BEGIN
>>   INSERT INTO log VALUES (tg_op || ' ' || coalesce(NEW.a, OLD.a) || ' ' || (SELECT count(*) FROM t));
>>   RETURN NULL;
>> END $$;
CREATE FUNCTION
