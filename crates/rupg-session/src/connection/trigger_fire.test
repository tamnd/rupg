> CREATE FUNCTION fix() RETURNS trigger LANGUAGE plpgsql AS $$
>> BEGIN
>>   IF NEW.a < 0 THEN
>>     RETURN NULL;
>>   END IF;
>>   NEW.b := upper(NEW.b);
>>   NEW.c := coalesce(NEW.c, 10);
>>   RETURN NEW;
>> END $$;
CREATE FUNCTION
