> SET TimeZone = 'UTC'
SET
> CREATE TABLE t (a int, b text, c int CHECK (c > 0));
CREATE TABLE
> CREATE FUNCTION show() RETURNS trigger LANGUAGE plpgsql AS $$
>> BEGIN
>>   RAISE NOTICE '% % % % % % % % % %', tg_name, tg_when, tg_level, tg_op, tg_relid = 't'::regclass, tg_relname, tg_table_name, tg_table_schema, tg_nargs, tg_argv;
>>   IF tg_level = 'ROW' THEN
>>     RAISE NOTICE 'new=% old=%', NEW, OLD;
>>   END IF;
>>   IF tg_op = 'DELETE' THEN
>>     RETURN OLD;
>>   END IF;
>>   RETURN NEW;
>> END $$;
CREATE FUNCTION
> CREATE TRIGGER bs BEFORE INSERT OR UPDATE OR DELETE ON t FOR EACH STATEMENT EXECUTE FUNCTION show('x', 'y');
CREATE TRIGGER
> CREATE TRIGGER br BEFORE INSERT OR UPDATE OR DELETE ON t FOR EACH ROW EXECUTE FUNCTION show();
CREATE TRIGGER
> CREATE TRIGGER ar AFTER INSERT OR UPDATE OR DELETE ON t FOR EACH ROW EXECUTE FUNCTION show(1);
CREATE TRIGGER
> CREATE TRIGGER as1 AFTER INSERT OR UPDATE OR DELETE ON t FOR EACH STATEMENT EXECUTE FUNCTION show();
CREATE TRIGGER
