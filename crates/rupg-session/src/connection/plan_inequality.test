!details
> SET TimeZone = 'UTC'
SET
> CREATE TABLE pi (a int, b int, c text, d date, n numeric, f float8, t timestamp, y bytea, g bigint);
CREATE TABLE
> INSERT INTO pi SELECT x, x % 100, 'v' || (x % 37), date '2020-01-01' + (x % 1000), x / 7.0, x * 0.25, timestamp '2021-03-01 00:00' + x * interval '17 minutes', ('\x' || lpad(to_hex(x), 6, '0'))::bytea, CASE WHEN x % 3 = 0 THEN NULL WHEN x <= 4000 THEN x % 40 ELSE x END FROM generate_series(1, 10000) x;
INSERT 0 10000
