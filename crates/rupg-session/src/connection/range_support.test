!details
> SET timezone = 'PST8PDT'
SET
TimeZone=PST8PDT
> explain (verbose, costs off) select current_date <@ daterange 'empty'
fields QUERY PLAN:25:-1:-1
row Result
row   Output: false
EXPLAIN
> explain (verbose, costs off) select current_date <@ daterange(NULL, NULL)
fields QUERY PLAN:25:-1:-1
row Result
row   Output: true
EXPLAIN
> explain (verbose, costs off) select current_date <@ daterange('2000-01-01', NULL, '[)')
fields QUERY PLAN:25:-1:-1
row Result
row   Output: (CURRENT_DATE >= '2000-01-01'::date)
EXPLAIN
> explain (verbose, costs off) select current_date <@ daterange(NULL, '2000-01-01', '(]')
fields QUERY PLAN:25:-1:-1
row Result
row   Output: (CURRENT_DATE < '2000-01-02'::date)
EXPLAIN
> explain (verbose, costs off) select current_date <@ daterange('-Infinity', '1997-04-10'::date, '()')
fields QUERY PLAN:25:-1:-1
row Result
row   Output: ((CURRENT_DATE > '-infinity'::date) AND (CURRENT_DATE < '1997-04-10'::date))
EXPLAIN
> explain (verbose, costs off) select current_date <@ daterange('2002-09-25'::date, 'Infinity', '[]')
fields QUERY PLAN:25:-1:-1
row Result
row   Output: ((CURRENT_DATE >= '2002-09-25'::date) AND (CURRENT_DATE <= 'infinity'::date))
EXPLAIN
> explain (verbose, costs off) select daterange('-Infinity', '1997-04-10'::date, '()') @> current_date
fields QUERY PLAN:25:-1:-1
row Result
row   Output: ((CURRENT_DATE > '-infinity'::date) AND (CURRENT_DATE < '1997-04-10'::date))
EXPLAIN
> explain (verbose, costs off) select now() <@ tstzrange('2024-01-20 00:00', '2024-01-21 00:00')
fields QUERY PLAN:25:-1:-1
row Result
row   Output: ((now() >= '2024-01-20 00:00:00-08'::timestamp with time zone) AND (now() < '2024-01-21 00:00:00-08'::timestamp with time zone))
EXPLAIN
> explain (verbose, costs off) select clock_timestamp() <@ tstzrange('2024-01-20 00:00', '2024-01-21 00:00')
fields QUERY PLAN:25:-1:-1
row Result
row   Output: (clock_timestamp() <@ '["2024-01-20 00:00:00-08","2024-01-21 00:00:00-08")'::tstzrange)
EXPLAIN
> explain (verbose, costs off) select clock_timestamp() <@ tstzrange('2024-01-20 00:00', NULL)
fields QUERY PLAN:25:-1:-1
row Result
row   Output: (clock_timestamp() >= '2024-01-20 00:00:00-08'::timestamp with time zone)
EXPLAIN
> create type textrange_supp as range (subtype = text, subtype_opclass = text_pattern_ops)
CREATE TYPE
> create temp table text_support_test (t text collate "C")
CREATE TABLE
> insert into text_support_test values ('a'), ('c'), ('d'), ('ch')
INSERT 0 4
> explain (costs off) select * from text_support_test where t <@ textrange_supp('a', 'd')
fields QUERY PLAN:25:-1:-1
row Seq Scan on text_support_test
row   Filter: ((t ~>=~ 'a'::text) AND (t ~<~ 'd'::text))
EXPLAIN
> select * from text_support_test where t <@ textrange_supp('a', 'd')
fields t@text_support_test.1:25:-1:-1
row a
row c
row ch
SELECT 3
> create table rs_t (i int, n numeric)
CREATE TABLE
> insert into rs_t select g, g / 2.0 from generate_series(1, 10) g
INSERT 0 10
> explain (costs off) select * from rs_t where i <@ int4range(3, 6)
fields QUERY PLAN:25:-1:-1
row Seq Scan on rs_t
row   Filter: ((i >= 3) AND (i < 6))
EXPLAIN
> select * from rs_t where i <@ int4range(3, 6)
fields i@rs_t.1:23:4:-1,n@rs_t.2:1700:-1:-1
row 3,1.5000000000000000
row 4,2.0000000000000000
row 5,2.5000000000000000
SELECT 3
> explain (costs off) select * from rs_t where numrange(1, 3, '(]') @> n
fields QUERY PLAN:25:-1:-1
row Seq Scan on rs_t
row   Filter: ((n > '1'::numeric) AND (n <= '3'::numeric))
EXPLAIN
> select * from rs_t where numrange(1, 3, '(]') @> n
fields i@rs_t.1:23:4:-1,n@rs_t.2:1700:-1:-1
row 3,1.5000000000000000
row 4,2.0000000000000000
row 5,2.5000000000000000
row 6,3.0000000000000000
SELECT 4
> explain (costs off) select * from rs_t where i <@ int4range(NULL, 3)
fields QUERY PLAN:25:-1:-1
row Seq Scan on rs_t
row   Filter: (i < 3)
EXPLAIN
> explain (costs off) select * from rs_t where (i + i * i + i * i * i + i * i * i * i + i * i) <@ int4range(3, 6)
fields QUERY PLAN:25:-1:-1
row Seq Scan on rs_t
row   Filter: (((((i + (i * i)) + ((i * i) * i)) + (((i * i) * i) * i)) + (i * i)) <@ '[3,6)'::int4range)
EXPLAIN
> explain (costs off) select * from rs_t where i <@ 'empty'::int4range
fields QUERY PLAN:25:-1:-1
row Result
row   Replaces: Scan on rs_t
row   One-Time Filter: false
EXPLAIN
> explain (costs off) select * from rs_t where i <@ NULL::int4range
fields QUERY PLAN:25:-1:-1
row Result
row   Replaces: Scan on rs_t
row   One-Time Filter: false
EXPLAIN
