> create table sa (unique1 int, two int, four int, hundred int, thousand int) with (parallel_workers = 4)
CREATE TABLE
> insert into sa select i, i % 2, i % 4, i % 100, i % 1000 from generate_series(0, 9999) i
INSERT 0 10000
> create index sa_hundred on sa (hundred)
CREATE INDEX
> create table sb (unique1 int, hundred int, thousand int)
CREATE TABLE
> insert into sb select i, i % 100, i % 1000 from generate_series(0, 9999) i
INSERT 0 10000
> vacuum analyze sa
VACUUM
> vacuum analyze sb
