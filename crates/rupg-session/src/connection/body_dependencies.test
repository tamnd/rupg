!details
> CREATE TABLE bd_t (id int, name text)
CREATE TABLE
> CREATE DOMAIN bd_d AS int CHECK (VALUE > 0)
CREATE DOMAIN
> CREATE FUNCTION bd_f(a int) RETURNS int RETURN a + 1
CREATE FUNCTION
> CREATE FUNCTION bd_ret(a int) RETURNS boolean RETURN EXISTS (SELECT 1 FROM bd_t WHERE id = bd_f(a))
CREATE FUNCTION
> CREATE FUNCTION bd_atomic(a int) RETURNS SETOF text BEGIN ATOMIC SELECT name FROM bd_t WHERE id = a; END
CREATE FUNCTION
> CREATE FUNCTION bd_dom(a bd_d) RETURNS bd_d RETURN (SELECT max(id) FROM bd_t t WHERE t.id > a)::bd_d
CREATE FUNCTION
> CREATE FUNCTION bd_whole(a int) RETURNS bigint BEGIN ATOMIC SELECT count(*) FROM bd_t; END
CREATE FUNCTION
> CREATE FUNCTION bd_two(a int) RETURNS text RETURN (SELECT name FROM bd_t WHERE id = a) || (SELECT name FROM bd_t WHERE id = bd_f(a))
CREATE FUNCTION
> SELECT objid::regprocedure::text AS f, refclassid::regclass::text AS c, CASE refclassid WHEN 'pg_proc'::regclass THEN refobjid::regprocedure::text WHEN 'pg_class'::regclass THEN refobjid::regclass::text WHEN 'pg_type'::regclass THEN refobjid::regtype::text ELSE refobjid::text END AS r, refobjsubid, deptype FROM pg_depend WHERE classid = 'pg_proc'::regclass AND objid IN (SELECT oid FROM pg_proc WHERE proname LIKE 'bd\_%') ORDER BY f, c, r, refobjsubid
