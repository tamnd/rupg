> CREATE FUNCTION merge_sf_test2()
>>  RETURNS void
>>  LANGUAGE sql
>> BEGIN ATOMIC
>>  MERGE INTO sf_target t
>>    USING rule_merge1 s
>>    ON (s.a = t.id)
>> WHEN NOT MATCHED
>>    THEN INSERT (data, id)
>>    VALUES (s.a, s.a)
>> WHEN MATCHED
>>    THEN UPDATE SET data = s.b
>> WHEN NOT MATCHED BY SOURCE
>>    THEN DELETE;
>> END;
CREATE FUNCTION
> SELECT pg_get_functiondef('merge_sf_test2'::regproc);
fields pg_get_functiondef:25:-1:-1
row CREATE OR REPLACE FUNCTION public.merge_sf_test2()
 RETURNS void
 LANGUAGE sql
BEGIN ATOMIC
 MERGE INTO sf_target t
    USING rule_merge1 s
    ON (s.a = t.id)
    WHEN NOT MATCHED BY TARGET
     THEN INSERT (data, id)
      VALUES (s.a, s.a)
    WHEN MATCHED
     THEN UPDATE SET data = s.b
    WHEN NOT MATCHED BY SOURCE
     THEN DELETE;
END

