> CREATE FUNCTION ds_trig() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE NOTICE '% % % on %', TG_WHEN, TG_LEVEL, TG_OP, TG_TABLE_NAME; IF TG_LEVEL = 'ROW' AND TG_OP <> 'DELETE' THEN RETURN NEW; END IF; RETURN NULL; END $$;
CREATE FUNCTION
> CREATE TRIGGER ds_bs BEFORE INSERT OR UPDATE ON ds_t FOR EACH STATEMENT EXECUTE FUNCTION ds_trig();
CREATE TRIGGER
> CREATE TRIGGER ds_as AFTER INSERT OR UPDATE ON ds_t FOR EACH STATEMENT EXECUTE FUNCTION ds_trig();
CREATE TRIGGER
> CREATE TRIGGER ds_br BEFORE INSERT OR UPDATE ON ds_t FOR EACH ROW EXECUTE FUNCTION ds_trig();
CREATE TRIGGER
> CREATE TRIGGER ds_ar AFTER INSERT OR UPDATE ON ds_t FOR EACH ROW EXECUTE FUNCTION ds_trig();
CREATE TRIGGER
