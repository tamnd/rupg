> CREATE FUNCTION trg() RETURNS trigger LANGUAGE plpgsql AS $$
>> BEGIN
>>   RAISE NOTICE '% % % %', TG_OP, TG_TABLE_NAME, old, new;
>>   RETURN new;
>> END $$;
CREATE FUNCTION
