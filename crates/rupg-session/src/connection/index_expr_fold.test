> create table bt (a int, b text)
CREATE TABLE
> insert into bt select g, g::text from generate_series(1, 1000) g
INSERT 0 1000
> create index bt_e on bt ((a + (2 * 3)))
CREATE INDEX
> create index bt_p on bt (a) where a > 2 + 3 and b <> 'x' || 'y'
CREATE INDEX
> analyze bt
ANALYZE
> explain (costs off) select * from bt where a + 6 = 10
fields QUERY PLAN:25:-1:-1
row Index Scan using bt_e on bt
row   Index Cond: ((a + 6) = 10)
EXPLAIN
> select * from bt where a + 6 = 10
fields a@bt.1:23:4:-1,b@bt.2:25:-1:-1
row 4,4
SELECT 1
> explain (costs off) select * from bt where a = 7 and a > 5 and b <> 'xy'
fields QUERY PLAN:25:-1:-1
row Index Scan using bt_p on bt
row   Index Cond: (a = 7)
EXPLAIN
> select pg_get_indexdef('bt_e'::regclass), pg_get_indexdef('bt_p'::regclass)
fields pg_get_indexdef:25:-1:-1,pg_get_indexdef:25:-1:-1
row CREATE INDEX bt_e ON public.bt USING btree (((a + (2 * 3)))),CREATE INDEX bt_p ON public.bt USING btree (a) WHERE ((a > (2 + 3)) AND (b <> ('x'::text || 'y'::text)))
SELECT 1
