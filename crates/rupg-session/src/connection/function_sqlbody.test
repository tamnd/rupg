> CREATE TABLE sb_t (id int, name text);
CREATE TABLE
> CREATE FUNCTION sb_ret(a int, b int) RETURNS bigint RETURN a + b;
CREATE FUNCTION
> CREATE FUNCTION sb_noname(int) RETURNS int RETURN $1 * 2;
CREATE FUNCTION
> CREATE FUNCTION sb_text() RETURNS text RETURN 'abc';
CREATE FUNCTION
> CREATE FUNCTION sb_case(x int) RETURNS text RETURN CASE WHEN x > 0 THEN 'pos' ELSE 'neg' END;
CREATE FUNCTION
> CREATE FUNCTION sb_sub(a int) RETURNS boolean RETURN EXISTS (SELECT 1 FROM sb_t WHERE id = a);
CREATE FUNCTION
> CREATE FUNCTION sb_atomic(a int) RETURNS int BEGIN ATOMIC SELECT a + 1; END;
CREATE FUNCTION
> CREATE FUNCTION sb_from(a int) RETURNS SETOF text BEGIN ATOMIC SELECT name FROM sb_t WHERE id = a ORDER BY name; END;
CREATE FUNCTION
> CREATE FUNCTION sb_join(a int) RETURNS bigint BEGIN ATOMIC SELECT count(*) FROM sb_t s JOIN sb_t u ON s.id = u.id WHERE s.id > a; END;
CREATE FUNCTION
> CREATE FUNCTION sb_out(a int, OUT b int, OUT c int) BEGIN ATOMIC SELECT a, a * 2; END;
CREATE FUNCTION
> CREATE FUNCTION sb_str(a int) RETURNS int AS 'SELECT a' LANGUAGE sql;
CREATE FUNCTION
> CREATE PROCEDURE sb_proc(a int) BEGIN ATOMIC SELECT a; END;
CREATE PROCEDURE
