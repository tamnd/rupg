> SELECT pg_get_function_sqlbody('sb_join'::regproc);
fields pg_get_function_sqlbody:25:-1:-1
row BEGIN ATOMIC
 SELECT count(*) AS count
    FROM (sb_t s
      JOIN sb_t u ON ((s.id = u.id)))
   WHERE (s.id > sb_join.a);
END
