!details
> create table orders (o_id int primary key, o_alt int unique, note text)
CREATE TABLE
> create table lineitem (l_id int, l_order int, l_alt int, l_text text)
CREATE TABLE
> create index li_ord on lineitem using link (l_order) with (parent = 'orders')
CREATE INDEX
