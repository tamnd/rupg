> create table parts (p_id int primary key, p_name text)
CREATE TABLE
> create table supply (s_line int, s_part int)
CREATE TABLE
> create index su_part on supply using link (s_part) with (parent = 'parts')
CREATE INDEX
> insert into parts values (7, 'bolt'), (8, 'nut')
INSERT 0 2
> insert into supply values (1, 7), (1, 8), (3, 8), (5, 7)
INSERT 0 4
> explain (costs off) select l_id, note, p_name from lineitem join orders on l_order = o_id join supply on s_line = l_id join parts on s_part = p_id
fields QUERY PLAN:25:-1:-1
row Merge Join
row   Merge Cond: (lineitem.l_id = supply.s_line)
row   ->  Sort
row         Sort Key: lineitem.l_id
row         ->  Link Join
row               Link Cond: (lineitem.l_order = orders.o_id)
row               ->  Seq Scan on lineitem
row               ->  Seq Scan on orders
row   ->  Sort
row         Sort Key: supply.s_line
row         ->  Link Join
row               Link Cond: (supply.s_part = parts.p_id)
row               ->  Seq Scan on supply
row               ->  Seq Scan on parts
EXPLAIN
