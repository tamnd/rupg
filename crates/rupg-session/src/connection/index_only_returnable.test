fields QUERY PLAN:25:-1:-1
row Index Only Scan using gr_p on gr  (cost=0.14..8.16 rows=1 width=16)
row   Index Cond: (p <@ '(1,1),(0,0)'::box)
EXPLAIN
> insert into gr select g, point(g, g), box(point(g, g), point(g + 1, g + 1)), polygon(box(point(g, g), point(g + 1, g + 1))), g::text, circle(point(g, g), 1), int4range(g, g + 3) from generate_series(1, 500) g
INSERT 0 500
