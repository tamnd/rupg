!details
> create table gr (a int, p point, b box, g polygon, t text, c circle, r int4range)
CREATE TABLE
> create index gr_p on gr using gist (p)
CREATE INDEX
> create index gr_b on gr using gist (b) include (a)
CREATE INDEX
> create index gr_c on gr using gist (c)
CREATE INDEX
> create index gr_t on gr using spgist (t)
CREATE INDEX
> create index gr_g on gr using spgist (g)
CREATE INDEX
> create index gr_r on gr using spgist (r)
CREATE INDEX
> set enable_seqscan = off
SET
> set enable_bitmapscan = off
SET
