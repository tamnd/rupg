INSERT 0 100
> INSERT INTO c1 SELECT g, 'c' || g FROM generate_series(1, 1000) g;
INSERT 0 1000
> INSERT INTO c2 SELECT g, 'd' || g, g FROM generate_series(1, 3000) g;
INSERT 0 3000
