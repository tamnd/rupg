> INSERT INTO td SELECT CASE WHEN i % 97 = 0 THEN NULL ELSE i % 13 END, CASE WHEN i % 11 = 0 THEN NULL ELSE (i / 13) % (50 + (i % 13) * 30) END, i % 50 FROM generate_series(1, 150000) i
