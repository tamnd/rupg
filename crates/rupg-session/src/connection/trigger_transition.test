> SET TimeZone = 'UTC'
SET
> CREATE TABLE tt (id int, val text);
CREATE TABLE
> CREATE FUNCTION tt_ins() RETURNS trigger LANGUAGE plpgsql AS $$ DECLARE r record; BEGIN RAISE NOTICE 'ins % rows, sum %', (SELECT count(*) FROM newtab), (SELECT sum(id) FROM newtab); FOR r IN SELECT * FROM newtab ORDER BY id LOOP RAISE NOTICE 'new % %', r.id, r.val; END LOOP; RETURN NULL; END $$;
CREATE FUNCTION
> CREATE TRIGGER tt_ins AFTER INSERT ON tt REFERENCING NEW TABLE AS newtab FOR EACH STATEMENT EXECUTE FUNCTION tt_ins();
CREATE TRIGGER
> INSERT INTO tt VALUES (1, 'one'), (2, 'two'), (3, 'three');
NOTICE 00000 ins 3 rows, sum 6 (PL/pgSQL function tt_ins() line 1 at RAISE)
NOTICE 00000 new 1 one (PL/pgSQL function tt_ins() line 1 at RAISE)
NOTICE 00000 new 2 two (PL/pgSQL function tt_ins() line 1 at RAISE)
NOTICE 00000 new 3 three (PL/pgSQL function tt_ins() line 1 at RAISE)
INSERT 0 3
> INSERT INTO tt SELECT 4, 'four' WHERE false;
NOTICE 00000 ins 0 rows, sum <NULL> (PL/pgSQL function tt_ins() line 1 at RAISE)
INSERT 0 0
> CREATE FUNCTION tt_upd() RETURNS trigger LANGUAGE plpgsql AS $$ DECLARE r record; BEGIN FOR r IN SELECT o.id, o.val AS before, n.val AS after FROM oldtab o JOIN newtab n USING (id) ORDER BY id LOOP RAISE NOTICE '% % -> %', r.id, r.before, r.after; END LOOP; RETURN NULL; END $$;
CREATE FUNCTION
> CREATE TRIGGER tt_upd AFTER UPDATE ON tt REFERENCING OLD TABLE AS oldtab NEW TABLE AS newtab FOR EACH STATEMENT EXECUTE FUNCTION tt_upd();
CREATE TRIGGER
> UPDATE tt SET val = upper(val) WHERE id >= 2;
NOTICE 00000 2 two -> TWO (PL/pgSQL function tt_upd() line 1 at RAISE)
NOTICE 00000 3 three -> THREE (PL/pgSQL function tt_upd() line 1 at RAISE)
UPDATE 2
> UPDATE tt SET val = val WHERE id > 100;
UPDATE 0
> CREATE FUNCTION tt_del() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE NOTICE 'del %', (SELECT string_agg(id::text || ':' || val, ',' ORDER BY id) FROM gone); RETURN NULL; END $$;
CREATE FUNCTION
> CREATE TRIGGER tt_del AFTER DELETE ON tt REFERENCING OLD TABLE AS gone FOR EACH STATEMENT EXECUTE FUNCTION tt_del();
CREATE TRIGGER
> DELETE FROM tt WHERE id = 1;
NOTICE 00000 del 1:one (PL/pgSQL function tt_del() line 1 at RAISE)
DELETE 1
