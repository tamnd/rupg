> CREATE TABLE bt (a int, b int);
CREATE TABLE
> CREATE FUNCTION bt_before() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN NEW.b := NEW.a * 10; RETURN NEW; END $$;
