> CREATE FUNCTION bt_after() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE NOTICE 'after %', (SELECT string_agg(a || '/' || b, ' ' ORDER BY a) FROM nb); RETURN NULL; END $$;
