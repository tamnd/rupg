> CREATE FUNCTION ms_g() RETURNS void LANGUAGE plpgsql AS $$ DECLARE r record; BEGIN UPDATE ms_t SET (a, b) = (SELECT 1, 2); FOR r IN SELECT a, b FROM ms_t LOOP RAISE NOTICE '% %', r.a, r.b; END LOOP; END $$;
