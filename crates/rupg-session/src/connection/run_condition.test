> EXPLAIN (COSTS OFF) SELECT * FROM (SELECT empno, row_number() OVER (ORDER BY empno) rn FROM emp) e WHERE rn < 3
fields QUERY PLAN:25:-1:-1
row WindowAgg
row   Window: w1 AS (ORDER BY emp.empno ROWS UNBOUNDED PRECEDING)
row   Run Condition: (row_number() OVER w1 < 3)
row   ->  Sort
row         Sort Key: emp.empno
row         ->  Seq Scan on emp
EXPLAIN
