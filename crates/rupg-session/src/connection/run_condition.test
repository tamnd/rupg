> EXPLAIN (COSTS OFF) SELECT * FROM (SELECT empno, dense_rank() OVER (ORDER BY salary DESC) dr FROM emp) e WHERE dr = 1
fields QUERY PLAN:25:-1:-1
row Subquery Scan on e
row   Filter: (e.dr = 1)
row   ->  WindowAgg
row         Window: w1 AS (ORDER BY emp.salary ROWS UNBOUNDED PRECEDING)
row         Run Condition: (dense_rank() OVER w1 <= 1)
row         ->  Sort
row               Sort Key: emp.salary DESC
row               ->  Seq Scan on emp
EXPLAIN
