> EXPLAIN (COSTS OFF) SELECT * FROM (SELECT empno, salary, row_number() OVER (ORDER BY empno) rn, rank() OVER (PARTITION BY depname ORDER BY salary) r FROM emp) e WHERE rn <= 2 AND r < 3
fields QUERY PLAN:25:-1:-1
row Subquery Scan on e
row   ->  WindowAgg
row         Window: w2 AS (ORDER BY emp.empno ROWS UNBOUNDED PRECEDING)
row         Run Condition: (row_number() OVER w2 <= 2)
row         Filter: ((rank() OVER w1) < 3)
row         ->  Sort
row               Sort Key: emp.empno
row               ->  WindowAgg
row                     Window: w1 AS (PARTITION BY emp.depname ORDER BY emp.salary ROWS UNBOUNDED PRECEDING)
row                     Run Condition: (rank() OVER w1 < 3)
row                     ->  Sort
row                           Sort Key: emp.depname, emp.salary
row                           ->  Seq Scan on emp
EXPLAIN
