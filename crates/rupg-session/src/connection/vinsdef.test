> CREATE PROCEDURE p6() LANGUAGE sql BEGIN ATOMIC INSERT INTO u VALUES (1, (SELECT max(a) FROM t)); INSERT INTO u VALUES (1, '2'); END;
CREATE PROCEDURE
> SELECT pg_get_functiondef('p6'::regproc);
fields pg_get_functiondef:25:-1:-1
row CREATE OR REPLACE PROCEDURE vid.p6()
 LANGUAGE sql
BEGIN ATOMIC
 INSERT INTO u (a, b)
   VALUES (1, ( SELECT max(t.a) AS max
            FROM t));
 INSERT INTO u (a, b)
   VALUES (1, 2);
END

