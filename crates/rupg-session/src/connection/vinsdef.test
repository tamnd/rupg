> CREATE FUNCTION f1(n int) RETURNS int LANGUAGE sql BEGIN ATOMIC INSERT INTO t (a) VALUES (n + 1); SELECT count(*)::int FROM t; END;
CREATE FUNCTION
> SELECT pg_get_functiondef('f1'::regproc);
fields pg_get_functiondef:25:-1:-1
row CREATE OR REPLACE FUNCTION vid.f1(n integer)
 RETURNS integer
 LANGUAGE sql
BEGIN ATOMIC
 INSERT INTO t (a)
   VALUES ((f1.n + 1));
 SELECT (count(*))::integer AS count
    FROM t;
END

