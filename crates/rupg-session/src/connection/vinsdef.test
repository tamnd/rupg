SELECT 1
> CREATE PROCEDURE p4() LANGUAGE sql BEGIN ATOMIC INSERT INTO t (a) SELECT g FROM generate_series(1, 3) g WHERE g > 1; INSERT INTO t SELECT a, b FROM t; END;
CREATE PROCEDURE
> SELECT pg_get_functiondef('p4'::regproc);
fields pg_get_functiondef:25:-1:-1
row CREATE OR REPLACE PROCEDURE vid.p4()
 LANGUAGE sql
BEGIN ATOMIC
 INSERT INTO t (a)  SELECT g.g
            FROM generate_series(1, 3) g(g)
           WHERE (g.g > 1);
 INSERT INTO t (a, b)  SELECT t_1.a,
             t_1.b
            FROM t t_1;
END

SELECT 1
> CREATE PROCEDURE p5() LANGUAGE sql BEGIN ATOMIC INSERT INTO t (a, c) OVERRIDING SYSTEM VALUE VALUES (1, 5); INSERT INTO t (a, c) OVERRIDING USER VALUE VALUES (1, 5); END;
CREATE PROCEDURE
> SELECT pg_get_functiondef('p5'::regproc);
fields pg_get_functiondef:25:-1:-1
row CREATE OR REPLACE PROCEDURE vid.p5()
 LANGUAGE sql
BEGIN ATOMIC
 INSERT INTO t (a, c) OVERRIDING SYSTEM VALUE
   VALUES (1, 5);
 INSERT INTO t (a, c) OVERRIDING USER VALUE
   VALUES (1, 5);
END

