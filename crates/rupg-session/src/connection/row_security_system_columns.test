!details
> SET TimeZone = 'UTC'
SET
> CREATE ROLE regress_rls_u7;
CREATE ROLE
> GRANT CREATE ON SCHEMA public TO regress_rls_u7;
GRANT
> CREATE FUNCTION rls7_leak(text) RETURNS bool COST 0.0000001 LANGUAGE plpgsql AS 'BEGIN RAISE NOTICE ''leak => %'', $1; RETURN true; END';
CREATE FUNCTION
> CREATE TABLE rls7_p (a int, b text);
CREATE TABLE
> CREATE TABLE rls7_c (c int) INHERITS (rls7_p);
CREATE TABLE
> GRANT ALL ON rls7_p, rls7_c TO regress_rls_u7;
GRANT
> INSERT INTO rls7_p VALUES (1, 'one'), (2, 'two'), (3, 'three');
INSERT 0 3
> INSERT INTO rls7_c VALUES (4, 'four', 40), (5, 'five', 50);
INSERT 0 2
> ALTER TABLE rls7_p ENABLE ROW LEVEL SECURITY;
ALTER TABLE
> ALTER TABLE rls7_c ENABLE ROW LEVEL SECURITY;
ALTER TABLE
> CREATE POLICY p7 ON rls7_p USING (a % 2 = 1);
CREATE POLICY
> CREATE POLICY p7c ON rls7_c USING (a % 2 = 0);
CREATE POLICY
> CREATE TABLE rls7_b (a int, b text);
CREATE TABLE
> GRANT ALL ON rls7_b TO regress_rls_u7;
GRANT
> INSERT INTO rls7_b SELECT g, 'b' || g FROM generate_series(1, 8) g;
INSERT 0 8
> ALTER TABLE rls7_b ENABLE ROW LEVEL SECURITY;
ALTER TABLE
> CREATE POLICY p7b ON rls7_b USING (a % 2 = 0) WITH CHECK (a % 2 = 0);
CREATE POLICY
> CREATE TABLE rls7_part (a int, b text) PARTITION BY RANGE (a);
CREATE TABLE
> CREATE TABLE rls7_part1 PARTITION OF rls7_part FOR VALUES FROM (0) TO (5);
CREATE TABLE
> CREATE TABLE rls7_part2 PARTITION OF rls7_part FOR VALUES FROM (5) TO (10);
CREATE TABLE
> GRANT ALL ON rls7_part TO regress_rls_u7;
GRANT
> INSERT INTO rls7_part SELECT g, 'p' || g FROM generate_series(1, 8) g;
INSERT 0 8
> ALTER TABLE rls7_part ENABLE ROW LEVEL SECURITY;
ALTER TABLE
> CREATE POLICY p7p ON rls7_part USING (a > 2 AND a < 7);
CREATE POLICY
> SET SESSION AUTHORIZATION regress_rls_u7;
SET
session_authorization=regress_rls_u7
is_superuser=off
> CREATE VIEW rls7_v WITH (security_barrier) AS SELECT * FROM rls7_b WHERE a > 0 WITH CHECK OPTION;
CREATE VIEW
