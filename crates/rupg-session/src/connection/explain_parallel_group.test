> create table ga (unique1 int, two int, four int, ten int, stringu1 name) with (parallel_workers = 4)
CREATE TABLE
> insert into ga select i, i % 2, i % 4, i % 10, (chr(65 + i % 26) || repeat(chr(66 + i % 7), i % 5))::name from generate_series(0, 9999) i
INSERT 0 10000
