> INSERT INTO gm SELECT i, CASE WHEN i % 11 = 0 THEN NULL WHEN i % 5 = 0 THEN '' ELSE 'v' || (i % 97) || repeat('é', i % 4) END, i % 13 FROM generate_series(1, 300000) i
