> SET TimeZone = 'UTC'
SET
> CREATE TABLE t (id int PRIMARY KEY, a int, s text, b bool);
CREATE TABLE
> CREATE INDEX t_lower ON t (lower(s));
CREATE INDEX
> CREATE INDEX t_part ON t (a) WHERE b;
CREATE INDEX
> CREATE INDEX t_expr2 ON t ((a + 1), id);
CREATE INDEX
> EXPLAIN (COSTS OFF) SELECT * FROM t WHERE lower(s) = 'x';
fields QUERY PLAN:25:-1:-1
row Bitmap Heap Scan on t
row   Recheck Cond: (lower(s) = 'x'::text)
row   ->  Bitmap Index Scan on t_lower
row         Index Cond: (lower(s) = 'x'::text)
EXPLAIN
> EXPLAIN SELECT id FROM t WHERE lower(s) = 'x';
fields QUERY PLAN:25:-1:-1
row Bitmap Heap Scan on t  (cost=4.20..13.68 rows=6 width=4)
row   Recheck Cond: (lower(s) = 'x'::text)
row   ->  Bitmap Index Scan on t_lower  (cost=0.00..4.20 rows=6 width=0)
row         Index Cond: (lower(s) = 'x'::text)
EXPLAIN
> EXPLAIN (COSTS OFF) SELECT * FROM t WHERE a = 5 AND b;
fields QUERY PLAN:25:-1:-1
row Bitmap Heap Scan on t
row   Recheck Cond: ((a = 5) AND b)
row   ->  Bitmap Index Scan on t_part
row         Index Cond: (a = 5)
EXPLAIN
> EXPLAIN SELECT * FROM t WHERE a = 5 AND b;
fields QUERY PLAN:25:-1:-1
row Bitmap Heap Scan on t  (cost=4.13..11.24 rows=3 width=41)
row   Recheck Cond: ((a = 5) AND b)
row   ->  Bitmap Index Scan on t_part  (cost=0.00..4.13 rows=3 width=0)
row         Index Cond: (a = 5)
EXPLAIN
> EXPLAIN (COSTS OFF) SELECT * FROM t WHERE a = 5;
fields QUERY PLAN:25:-1:-1
row Seq Scan on t
row   Filter: (a = 5)
EXPLAIN
> EXPLAIN (COSTS OFF) SELECT * FROM t WHERE a + 1 = 3;
fields QUERY PLAN:25:-1:-1
row Bitmap Heap Scan on t
row   Recheck Cond: ((a + 1) = 3)
row   ->  Bitmap Index Scan on t_expr2
row         Index Cond: ((a + 1) = 3)
EXPLAIN
> EXPLAIN (COSTS OFF) SELECT * FROM t WHERE a + 1 = 3 AND id > 2;
fields QUERY PLAN:25:-1:-1
row Bitmap Heap Scan on t
row   Recheck Cond: (((a + 1) = 3) AND (id > 2))
row   ->  Bitmap Index Scan on t_expr2
row         Index Cond: (((a + 1) = 3) AND (id > 2))
EXPLAIN
> EXPLAIN VERBOSE SELECT lower(s) FROM t WHERE lower(s) > 'm';
fields QUERY PLAN:25:-1:-1
row Bitmap Heap Scan on public.t  (cost=7.20..24.08 rows=393 width=32)
row   Output: lower(s)
row   Recheck Cond: (lower(t.s) > 'm'::text)
row   ->  Bitmap Index Scan on t_lower  (cost=0.00..7.10 rows=393 width=0)
row         Index Cond: (lower(t.s) > 'm'::text)
EXPLAIN
> EXPLAIN (COSTS OFF) SELECT * FROM t ORDER BY lower(s) LIMIT 3;
fields QUERY PLAN:25:-1:-1
row Limit
row   ->  Index Scan using t_lower on t
EXPLAIN
> EXPLAIN (COSTS OFF) SELECT a FROM t WHERE b AND a > 3;
fields QUERY PLAN:25:-1:-1
row Bitmap Heap Scan on t
row   Recheck Cond: ((a > 3) AND b)
row   ->  Bitmap Index Scan on t_part
row         Index Cond: (a > 3)
EXPLAIN
> CREATE TABLE u (id int PRIMARY KEY, a int, s text, b bool, c varchar(20));
CREATE TABLE
> CREATE INDEX u_part ON u (a) WHERE b;
CREATE INDEX
> CREATE INDEX u_upper ON u (upper(c)) INCLUDE (id);
CREATE INDEX
> CREATE INDEX u_part2 ON u (id) WHERE a > 5 AND s IS NOT NULL;
CREATE INDEX
> EXPLAIN SELECT * FROM u WHERE upper(c) = 'C1';
fields QUERY PLAN:25:-1:-1
row Bitmap Heap Scan on u  (cost=4.17..11.29 rows=3 width=99)
row   Recheck Cond: (upper((c)::text) = 'C1'::text)
row   ->  Bitmap Index Scan on u_upper  (cost=0.00..4.17 rows=3 width=0)
row         Index Cond: (upper((c)::text) = 'C1'::text)
EXPLAIN
> EXPLAIN SELECT id FROM u WHERE upper(c) > 'C3' ORDER BY upper(c);
fields QUERY PLAN:25:-1:-1
row Sort  (cost=27.77..28.30 rows=213 width=36)
row   Sort Key: (upper((c)::text))
row   ->  Bitmap Heap Scan on u  (cost=5.80..19.53 rows=213 width=36)
row         Recheck Cond: (upper((c)::text) > 'C3'::text)
row         ->  Bitmap Index Scan on u_upper  (cost=0.00..5.75 rows=213 width=0)
row               Index Cond: (upper((c)::text) > 'C3'::text)
EXPLAIN
> EXPLAIN SELECT * FROM u WHERE id < 10 AND a > 5 AND s IS NOT NULL;
fields QUERY PLAN:25:-1:-1
row Bitmap Heap Scan on u  (cost=4.15..15.22 rows=71 width=99)
row   Recheck Cond: ((id < 10) AND (a > 5) AND (s IS NOT NULL))
row   ->  Bitmap Index Scan on u_part2  (cost=0.00..4.13 rows=71 width=0)
row         Index Cond: (id < 10)
EXPLAIN
> EXPLAIN SELECT * FROM u WHERE b AND (a = 1 OR a = 3);
fields QUERY PLAN:25:-1:-1
row Bitmap Heap Scan on u  (cost=4.13..11.25 rows=3 width=99)
row   Recheck Cond: (((a = 1) OR (a = 3)) AND b)
row   ->  Bitmap Index Scan on u_part  (cost=0.00..4.13 rows=3 width=0)
row         Index Cond: (a = ANY ('{1,3}'::integer[]))
EXPLAIN
> EXPLAIN SELECT * FROM u x JOIN u y ON upper(x.c) = upper(y.c) WHERE x.id = 3;
fields QUERY PLAN:25:-1:-1
row Nested Loop  (cost=4.33..19.50 rows=3 width=198)
row   ->  Index Scan using u_pkey on u x  (cost=0.15..8.17 rows=1 width=99)
row         Index Cond: (id = 3)
row   ->  Bitmap Heap Scan on u y  (cost=4.18..11.30 rows=3 width=99)
row         Recheck Cond: (upper((x.c)::text) = upper((c)::text))
row         ->  Bitmap Index Scan on u_upper  (cost=0.00..4.18 rows=3 width=0)
row               Index Cond: (upper((c)::text) = upper((x.c)::text))
EXPLAIN
> CREATE UNIQUE INDEX u_lower_s ON u (lower(s));
CREATE INDEX
> EXPLAIN SELECT * FROM u WHERE lower(s) = 'v7';
fields QUERY PLAN:25:-1:-1
row Index Scan using u_lower_s on u  (cost=0.15..8.17 rows=1 width=99)
row   Index Cond: (lower(s) = 'v7'::text)
EXPLAIN
> EXPLAIN (COSTS OFF) SELECT * FROM u WHERE lower(s) IN ('v1', 'v2');
fields QUERY PLAN:25:-1:-1
row Bitmap Heap Scan on u
row   Recheck Cond: (lower(s) = ANY ('{v1,v2}'::text[]))
row   ->  Bitmap Index Scan on u_lower_s
row         Index Cond: (lower(s) = ANY ('{v1,v2}'::text[]))
EXPLAIN
> EXPLAIN (COSTS OFF) SELECT * FROM u WHERE b ORDER BY a LIMIT 2;
fields QUERY PLAN:25:-1:-1
row Limit
row   ->  Index Scan using u_part on u
EXPLAIN
> EXPLAIN (COSTS OFF) SELECT * FROM u WHERE a > 5 AND s IS NOT NULL ORDER BY id;
fields QUERY PLAN:25:-1:-1
row Sort
row   Sort Key: id
row   ->  Bitmap Heap Scan on u
row         Recheck Cond: ((a > 5) AND (s IS NOT NULL))
row         ->  Bitmap Index Scan on u_part2
EXPLAIN
