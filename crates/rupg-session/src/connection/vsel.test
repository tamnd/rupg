> CREATE FUNCTION snoop(anyelement) RETURNS boolean AS $$ BEGIN RAISE NOTICE 'snooped value: %', $1; RETURN true; END; $$ LANGUAGE plpgsql COST 0.000001;
CREATE FUNCTION
> CREATE VIEW qv AS SELECT * FROM qo WHERE visibility = 'public';
