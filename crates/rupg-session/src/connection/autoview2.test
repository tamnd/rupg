>> -- Nested views with security_barrier and leaky functions
>> CREATE TABLE secret (id int, s text);
CREATE TABLE
> INSERT INTO secret VALUES (1, 'a'), (2, 'b'), (3, 'c');
INSERT 0 3
> CREATE FUNCTION snoop(anyelement) RETURNS bool LANGUAGE plpgsql AS $$
>> BEGIN RAISE NOTICE 'snooped value: %', $1; RETURN true; END $$;
CREATE FUNCTION
> CREATE VIEW sv1 WITH (security_barrier = true) AS SELECT id, s FROM secret WHERE id <> 2;
CREATE VIEW
> CREATE VIEW sv2 AS SELECT id, s FROM sv1 WHERE id <> 3;
CREATE VIEW
> UPDATE sv2 SET s = s || '!' WHERE snoop(s);
NOTICE 00000 snooped value: a (PL/pgSQL function snoop(anyelement) line 2 at RAISE)
UPDATE 1
> DELETE FROM sv2 WHERE snoop(id);
NOTICE 00000 snooped value: 1 (PL/pgSQL function snoop(anyelement) line 2 at RAISE)
DELETE 1
