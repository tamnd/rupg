> CREATE TABLE so (k int, d date, p text, c int)
CREATE TABLE
> INSERT INTO so SELECT i, date '1995-01-01' + i % 700, chr(65 + i % 5), CASE WHEN i % 11 = 0 THEN NULL ELSE i % 5000 END FROM generate_series(1, 150000) i
