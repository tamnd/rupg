> select row(b collate "C", b collate "POSIX") from cm1 order by 1
fields row:2249:-1:-1
row (Abc,Abc)
row (abc,abc)
SELECT 2
> select case when b collate "C" < 'x' collate "POSIX" then 1 end from cm1
ERROR 42P21 collation mismatch between explicit collations "C" and "POSIX" at 38
> with recursive foo(x) as (select x from (values('a' collate "C"),('b')) t(x) union all select (x || 'c') collate "POSIX" from foo where length(x) < 3) select * from foo
ERROR 42P21 recursive query "foo" column 1 has collation "C" in non-recursive term but collation "POSIX" overall at 34
HINT Use the COLLATE clause to set the collation of the non-recursive term.
> with recursive foo(x) as (select 'a' union all select x || 'c' from foo where length(x) < 3) select * from foo
fields x:25:-1:-1
row a
row ac
row acc
