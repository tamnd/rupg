> CREATE FUNCTION cf_pl(n int) RETURNS int LANGUAGE plpgsql AS $$
>> DECLARE r record; k int;
>> BEGIN
>>   FOR i IN 1..n LOOP
>>     EXECUTE format('DECLARE %I SCROLL CURSOR FOR SELECT a FROM cf_t WHERE a >= %s ORDER BY a', 'p_' || i, i);
>>     EXECUTE 'FETCH NEXT FROM ' || quote_ident('p_' || i) INTO r;
>>     RAISE NOTICE 'p_%: %', i, r.a;
>>   END LOOP;
>>   EXECUTE 'MOVE FORWARD 2 IN p_1';
>>   GET DIAGNOSTICS k = ROW_COUNT;
>>   RAISE NOTICE 'moved %', k;
>>   EXECUTE 'FETCH NEXT FROM p_1' INTO r;
>>   RAISE NOTICE 'next %', r.a;
>>   EXECUTE 'FETCH ALL FROM p_2';
>>   GET DIAGNOSTICS k = ROW_COUNT;
>>   RAISE NOTICE 'fetched %', k;
>>   EXECUTE 'CLOSE p_2';
>>   RETURN n;
>> END $$
CREATE FUNCTION
