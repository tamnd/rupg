> CREATE TABLE su (f1 int, f2 text, f3 float8)
CREATE TABLE
> INSERT INTO su VALUES (1, 'a', 1.5), (2, 'b', NULL)
INSERT 0 2
> CREATE TRIGGER su_t BEFORE UPDATE ON su FOR EACH ROW EXECUTE PROCEDURE suppress_redundant_updates_trigger()
CREATE TRIGGER
> UPDATE su SET f1 = f1
UPDATE 0
> UPDATE su SET f3 = 2 WHERE f3 IS NULL
UPDATE 1
> UPDATE su SET f2 = 'a' WHERE f1 = 1
UPDATE 0
> UPDATE su SET f2 = 'c' WHERE f1 = 1
UPDATE 1
> SELECT * FROM su ORDER BY f1
fields f1@su.1:23:4:-1,f2@su.2:25:-1:-1,f3@su.3:701:8:-1
row 1,c,1.5
row 2,b,2
SELECT 2
> CREATE TRIGGER su_u BEFORE INSERT ON su FOR EACH ROW EXECUTE PROCEDURE suppress_redundant_updates_trigger()
CREATE TRIGGER
> INSERT INTO su VALUES (3, 'c', 0)
ERROR 39P01 suppress_redundant_updates_trigger: must be called on update
> DROP TRIGGER su_u ON su
DROP TRIGGER
> CREATE TRIGGER su_v AFTER UPDATE ON su FOR EACH ROW EXECUTE PROCEDURE suppress_redundant_updates_trigger()
CREATE TRIGGER
> UPDATE su SET f1 = f1
UPDATE 0
> DROP TRIGGER su_v ON su
DROP TRIGGER
> CREATE TRIGGER su_w BEFORE UPDATE ON su FOR EACH STATEMENT EXECUTE PROCEDURE suppress_redundant_updates_trigger()
CREATE TRIGGER
> UPDATE su SET f1 = f1
ERROR 39P01 suppress_redundant_updates_trigger: must be called for each row
> CREATE FUNCTION trigger_return_old() RETURNS trigger AS '/home/tam/work/rupg-compat-work/oracle/19/src/src/test/regress/regress.so' LANGUAGE C
CREATE FUNCTION
> CREATE TABLE ro (f1 int, f2 text)
CREATE TABLE
> CREATE TRIGGER ro_t BEFORE INSERT OR DELETE OR UPDATE ON ro FOR EACH ROW EXECUTE PROCEDURE trigger_return_old()
CREATE TRIGGER
> INSERT INTO ro VALUES (1, 'foo')
INSERT 0 1
> SELECT * FROM ro
fields f1@ro.1:23:4:-1,f2@ro.2:25:-1:-1
row 1,foo
SELECT 1
> UPDATE ro SET f2 = f2 || 'bar'
UPDATE 1
> SELECT * FROM ro
fields f1@ro.1:23:4:-1,f2@ro.2:25:-1:-1
row 1,foo
SELECT 1
> DELETE FROM ro
DELETE 1
> SELECT * FROM ro
fields f1@ro.1:23:4:-1,f2@ro.2:25:-1:-1
SELECT 0
> ALTER TABLE ro ADD COLUMN f3 text
ALTER TABLE
> INSERT INTO ro VALUES (2, 'x', 'y')
INSERT 0 1
> UPDATE ro SET f3 = 'z'
UPDATE 1
> SELECT * FROM ro
fields f1@ro.1:23:4:-1,f2@ro.2:25:-1:-1,f3@ro.3:25:-1:-1
row 2,x,y
SELECT 1
> CREATE FUNCTION my_tsv() RETURNS trigger LANGUAGE internal AS 'tsvector_update_trigger_byid'
CREATE FUNCTION
> CREATE TABLE mt (a tsvector, t text)
CREATE TABLE
> CREATE TRIGGER mt_t BEFORE INSERT ON mt FOR EACH ROW EXECUTE PROCEDURE my_tsv(a, 'pg_catalog.simple', t)
CREATE TRIGGER
