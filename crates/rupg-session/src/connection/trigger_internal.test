!details
> CREATE TABLE tt (id int, a tsvector, t text, u varchar, cfg regconfig, n int)
CREATE TABLE
> CREATE TRIGGER tt_a BEFORE INSERT OR UPDATE ON tt FOR EACH ROW EXECUTE PROCEDURE tsvector_update_trigger(a, 'pg_catalog.english', t, u)
CREATE TRIGGER
> INSERT INTO tt (id, t, u) VALUES (1, 'The quick brown foxes', 'jumped over dogs')
INSERT 0 1
> INSERT INTO tt (id, t) VALUES (2, NULL)
INSERT 0 1
> SELECT id, a::text FROM tt ORDER BY id
fields id@tt.1:23:4:-1,a:25:-1:-1
row 1,'brown':3 'dog':7 'fox':4 'jump':5 'quick':2
row 2,
SELECT 2
> UPDATE tt SET t = 'lazy cats' WHERE id = 1
UPDATE 1
> SELECT id, a::text FROM tt ORDER BY id
fields id@tt.1:23:4:-1,a:25:-1:-1
row 1,'cat':2 'dog':5 'jump':3 'lazi':1
row 2,
SELECT 2
> UPDATE tt SET a = NULL, n = 1 WHERE id = 1
UPDATE 1
> SELECT id, a::text FROM tt ORDER BY id
fields id@tt.1:23:4:-1,a:25:-1:-1
row 1,NULL
row 2,
SELECT 2
> UPDATE tt SET u = 'running' WHERE id = 2
UPDATE 1
> SELECT id, a::text FROM tt ORDER BY id
fields id@tt.1:23:4:-1,a:25:-1:-1
row 1,NULL
row 2,'run':1
SELECT 2
