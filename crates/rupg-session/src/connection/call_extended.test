> SET TimeZone = 'UTC'
SET
> CREATE PROCEDURE p_inc(INOUT x int) LANGUAGE plpgsql AS $$
>> BEGIN
>>   x := x + 1;
>> END $$;
CREATE PROCEDURE
> CREATE PROCEDURE p_two(IN a int, OUT b int, INOUT c text) LANGUAGE plpgsql AS $$
>> BEGIN
>>   b := a * 2;
>>   c := c || '!';
>> END $$;
CREATE PROCEDURE
> CREATE TABLE t (a int);
CREATE TABLE
> CREATE PROCEDURE p_ins(a int) LANGUAGE plpgsql AS $$
>> BEGIN
>>   INSERT INTO t VALUES (a);
>>   RAISE NOTICE 'ins %', a;
>> END $$;
CREATE PROCEDURE
