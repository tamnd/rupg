> CREATE FUNCTION co_f() RETURNS int LANGUAGE plpgsql AS $$
>> DECLARE
>>   r record;
>>   cur CURSOR FOR SELECT a FROM co FOR UPDATE;
>>   n int := 0;
>> BEGIN
>>   FOR r IN cur LOOP
>>     UPDATE co SET a = a + 1000 WHERE CURRENT OF cur;
>>     n := n + 1;
>>   END LOOP;
>>   RETURN n;
>> END $$;
CREATE FUNCTION
> SELECT co_f();
