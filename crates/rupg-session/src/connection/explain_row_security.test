!details
> SET TimeZone = 'UTC'
SET
> CREATE ROLE regress_rx_u;
CREATE ROLE
> CREATE FUNCTION rx_leak(text) RETURNS bool COST 0.0000001 LANGUAGE plpgsql AS 'BEGIN RAISE NOTICE ''leak => %'', $1; RETURN true; END';
CREATE FUNCTION
> CREATE TABLE rx_lv (u name PRIMARY KEY, lv int);
CREATE TABLE
> INSERT INTO rx_lv VALUES ('regress_rx_u', 2);
INSERT 0 1
> CREATE TABLE rx_doc (id int PRIMARY KEY, lv int, cid int, title text, owner name);
CREATE TABLE
> INSERT INTO rx_doc SELECT g, g % 4, g % 3, 'doc' || g, CASE WHEN g % 2 = 0 THEN 'regress_rx_u' ELSE 'other' END FROM generate_series(1, 8) g;
INSERT 0 8
> CREATE TABLE rx_cat (cid int PRIMARY KEY, cname text);
CREATE TABLE
> INSERT INTO rx_cat VALUES (0, 'zero'), (1, 'one'), (2, 'two');
INSERT 0 3
> CREATE TABLE rx_p (a int, b text);
CREATE TABLE
> CREATE TABLE rx_c1 (c int) INHERITS (rx_p);
CREATE TABLE
> INSERT INTO rx_p SELECT g, 'p' || g FROM generate_series(1, 4) g;
INSERT 0 4
> INSERT INTO rx_c1 SELECT g, 'c' || g, g FROM generate_series(5, 8) g;
INSERT 0 4
> GRANT SELECT ON rx_lv, rx_doc, rx_cat, rx_p, rx_c1 TO regress_rx_u;
GRANT
> ALTER TABLE rx_doc ENABLE ROW LEVEL SECURITY;
ALTER TABLE
> ALTER TABLE rx_p ENABLE ROW LEVEL SECURITY;
ALTER TABLE
> CREATE POLICY d1 ON rx_doc USING (lv <= (SELECT lv FROM rx_lv WHERE u = current_user));
CREATE POLICY
> CREATE POLICY p1 ON rx_p USING (a % 2 = 0);
CREATE POLICY
> SET SESSION AUTHORIZATION regress_rx_u;
SET
session_authorization=regress_rx_u
is_superuser=off
> EXPLAIN (COSTS OFF) SELECT * FROM rx_doc WHERE rx_leak(title);
fields QUERY PLAN:25:-1:-1
row Seq Scan on rx_doc
row   Filter: ((lv <= (InitPlan expr_1).col1) AND rx_leak(title))
row   InitPlan expr_1
row     ->  Index Scan using rx_lv_pkey on rx_lv
row           Index Cond: (u = CURRENT_USER)
EXPLAIN
> EXPLAIN (COSTS OFF) SELECT * FROM rx_doc NATURAL JOIN rx_cat WHERE rx_leak(title);
fields QUERY PLAN:25:-1:-1
row Hash Join
row   Hash Cond: (rx_cat.cid = rx_doc.cid)
row   InitPlan expr_1
row     ->  Index Scan using rx_lv_pkey on rx_lv
row           Index Cond: (u = CURRENT_USER)
row   ->  Seq Scan on rx_cat
row   ->  Hash
row         ->  Seq Scan on rx_doc
row               Filter: ((lv <= (InitPlan expr_1).col1) AND rx_leak(title))
EXPLAIN
