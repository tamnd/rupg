row               Filter: ((a % 2) = 0)
EXPLAIN
> EXPLAIN (COSTS OFF) SELECT count(*) FROM (SELECT * FROM rx_doc WHERE rx_leak(title)) s;
fields QUERY PLAN:25:-1:-1
row Aggregate
row   InitPlan expr_1
row     ->  Index Scan using rx_lv_pkey on rx_lv
row           Index Cond: (u = CURRENT_USER)
row   ->  Seq Scan on rx_doc
row         Filter: ((lv <= (InitPlan expr_1).col1) AND rx_leak(title))
EXPLAIN
> EXPLAIN (COSTS OFF) SELECT * FROM rx_cat c WHERE EXISTS (SELECT 1 FROM rx_doc d WHERE d.cid = c.cid);
fields QUERY PLAN:25:-1:-1
row Hash Join
row   Hash Cond: (c.cid = d.cid)
row   InitPlan expr_1
row     ->  Index Scan using rx_lv_pkey on rx_lv
row           Index Cond: (u = CURRENT_USER)
row   ->  Seq Scan on rx_cat c
row   ->  Hash
row         ->  HashAggregate
row               Group Key: d.cid
row               ->  Seq Scan on rx_doc d
row                     Filter: (lv <= (InitPlan expr_1).col1)
EXPLAIN
