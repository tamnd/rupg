row Append
row   ->  Seq Scan on rx_p rx_p_1
row         Filter: (((a % 2) = 0) AND rx_leak(b))
row   ->  Seq Scan on rx_c1 rx_p_2
row         Filter: (((a % 2) = 0) AND rx_leak(b))
EXPLAIN
