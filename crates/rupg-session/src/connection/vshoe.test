>     CREATE TABLE shoelace_log (
>>         sl_name    char(10),
>>         sl_avail   integer,
>>         log_who    name,
>>         log_when   timestamp
>>     );
CREATE TABLE
>     CREATE RULE log_shoelace AS ON UPDATE TO shoelace_data
>>         WHERE NEW.sl_avail != OLD.sl_avail
>>         DO INSERT INTO shoelace_log VALUES (
>>                                         NEW.sl_name,
>>                                         NEW.sl_avail,
>>                                         'Al Bundy',
>>                                         'epoch'
>>                                     );
CREATE RULE
