>     CREATE VIEW shoelace_obsolete AS
>> 	SELECT * FROM shoelace WHERE NOT EXISTS
>> 	    (SELECT shoename FROM shoe WHERE slcolor = sl_color);
CREATE VIEW
>     CREATE VIEW shoelace_candelete AS
>> 	SELECT * FROM shoelace_obsolete WHERE sl_avail = 0;
CREATE VIEW
