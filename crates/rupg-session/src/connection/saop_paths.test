!details
> create table sa (a int, b int, c text)
CREATE TABLE
> insert into sa select g % 1000, g % 37, md5(g::text) from generate_series(1, 20000) g
INSERT 0 20000
> create index sa_ab on sa (a, b)
CREATE INDEX
> create index sa_h on sa using hash (c)
CREATE INDEX
> analyze sa
ANALYZE
