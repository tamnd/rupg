> CREATE FUNCTION mt_tt() RETURNS trigger LANGUAGE plpgsql AS $$
>> DECLARE r record;
>> BEGIN
>>   IF tg_op IN ('UPDATE', 'DELETE') THEN
>>     FOR r IN SELECT * FROM old_t ORDER BY id LOOP
>>       RAISE NOTICE '% old %', tg_name, r;
>>     END LOOP;
>>   END IF;
>>   IF tg_op IN ('UPDATE', 'INSERT') THEN
>>     FOR r IN SELECT * FROM new_t ORDER BY id LOOP
>>       RAISE NOTICE '% new %', tg_name, r;
>>     END LOOP;
>>   END IF;
>>   RETURN NULL;
>> END $$;
CREATE FUNCTION
