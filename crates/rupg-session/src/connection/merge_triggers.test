> CREATE FUNCTION mt_stmt() RETURNS trigger LANGUAGE plpgsql AS $$
>> BEGIN
>>   RAISE NOTICE '% % % %', tg_name, tg_when, tg_level, tg_op;
>>   RETURN NULL;
>> END $$;
CREATE FUNCTION
> CREATE FUNCTION mt_row() RETURNS trigger LANGUAGE plpgsql AS $$
>> BEGIN
>>   RAISE NOTICE '% % % old=% new=%', tg_name, tg_when, tg_op, old, new;
>>   IF tg_when = 'BEFORE' AND tg_op <> 'DELETE' THEN
>>     IF new.v = 55 THEN
>>       RETURN NULL;
>>     END IF;
>>     IF new.v = 66 THEN
>>       new.w := 'changed';
>>     END IF;
>>     IF new.v = 33 THEN
>>       new.v := 333;
>>     END IF;
>>   END IF;
>>   IF tg_when = 'BEFORE' AND tg_op = 'DELETE' AND old.id = 4 THEN
>>     RETURN NULL;
>>   END IF;
>>   IF tg_op = 'DELETE' THEN
>>     RETURN old;
>>   END IF;
>>   RETURN new;
>> END $$;
CREATE FUNCTION
