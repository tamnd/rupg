> CREATE VIEW xv2 AS SELECT xmlroot('<a/>', version '1.0', standalone yes) AS r1, xmlroot('<a/>', version no value) AS r2, xmlroot('<a/>', version '1.1', standalone no value) AS r3, xmlroot('<a/>', version '1.1', standalone no) AS r4, '<a/>'::xml IS DOCUMENT AS d, '<a/>'::xml IS NOT DOCUMENT AS nd, xmlserialize(content '<a/>' as varchar(10)) AS s1, xmlserialize(document '<a/>' as text) AS s2, xmlserialize(content '<a/>' as name) AS s3
CREATE VIEW
> SELECT pg_get_viewdef('xv2')
fields pg_get_viewdef:25:-1:-1
row  SELECT XMLROOT('<a/>'::xml, VERSION '1.0'::text, STANDALONE YES) AS r1,
    XMLROOT('<a/>'::xml, VERSION NO VALUE) AS r2,
    XMLROOT('<a/>'::xml, VERSION '1.1'::text, STANDALONE NO VALUE) AS r3,
    XMLROOT('<a/>'::xml, VERSION '1.1'::text, STANDALONE NO) AS r4,
    '<a/>'::xml IS DOCUMENT AS d,
    (NOT '<a/>'::xml IS DOCUMENT) AS nd,
    (XMLSERIALIZE(CONTENT '<a/>'::xml AS character varying(10) NO INDENT))::character varying(10) AS s1,
    XMLSERIALIZE(DOCUMENT '<a/>'::xml AS text NO INDENT) AS s2,
    (XMLSERIALIZE(CONTENT '<a/>'::xml AS name NO INDENT))::name AS s3;
