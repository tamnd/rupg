> CREATE VIEW xp1 AS SELECT xmlroot('<a/>', version '1.0', standalone yes) AS r1, '<a/>'::xml IS DOCUMENT AS d, '<a/>'::xml IS NOT DOCUMENT AS nd, (xmlelement(name a) IS DOCUMENT) IS TRUE AS d2, xmlserialize(content '<a/>' as varchar(10)) AS s1, xmlelement(name a, xmlattributes(1 + 2 AS b), 3 * 4, xmlconcat('<x/>', null)) AS e, NOT (xmlparse(content 'x') IS DOCUMENT) AND true AS d3
CREATE VIEW
> SELECT pg_get_viewdef('xp1', true)
fields pg_get_viewdef:25:-1:-1
row  SELECT XMLROOT('<a/>'::xml, VERSION '1.0'::text, STANDALONE YES) AS r1,
    ('<a/>'::xml) IS DOCUMENT AS d,
    NOT ('<a/>'::xml) IS DOCUMENT AS nd,
    (XMLELEMENT(NAME a)) IS DOCUMENT IS TRUE AS d2,
    XMLSERIALIZE(CONTENT '<a/>'::xml AS character varying(10) NO INDENT)::character varying(10) AS s1,
    XMLELEMENT(NAME a, XMLATTRIBUTES(1 + 2 AS b), 3 * 4, XMLCONCAT('<x/>'::xml, NULL::xml)) AS e,
    NOT (XMLPARSE(CONTENT 'x'::text STRIP WHITESPACE)) IS DOCUMENT AND true AS d3;
