> CREATE VIEW wgrp_v AS SELECT p, sum(v) AS s, rank() OVER (ORDER BY sum(v)) AS r, sum(sum(v)) OVER w AS t FROM wgrp_t GROUP BY p WINDOW w AS (ORDER BY p)
CREATE VIEW
> SELECT pg_get_viewdef('wgrp_v'::regclass)
fields pg_get_viewdef:25:-1:-1
row  SELECT p,
    sum(v) AS s,
    rank() OVER (ORDER BY (sum(v))) AS r,
    sum(sum(v)) OVER w AS t
   FROM wgrp_t
  GROUP BY p
  WINDOW w AS (ORDER BY p);
SELECT 1
