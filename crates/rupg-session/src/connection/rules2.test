> CREATE TABLE r_t (id int, v text);
CREATE TABLE
> CREATE TABLE r_log (op text, id int, v text);
CREATE TABLE
> CREATE RULE r_ins AS ON INSERT TO r_t DO ALSO INSERT INTO r_log VALUES ('ins', NEW.id, NEW.v);
CREATE RULE
> CREATE RULE r_del AS ON DELETE TO r_t DO ALSO INSERT INTO r_log VALUES ('del', OLD.id, OLD.v);
CREATE RULE
> CREATE RULE r_upd AS ON UPDATE TO r_t WHERE OLD.v <> NEW.v DO ALSO INSERT INTO r_log VALUES ('upd', OLD.id, OLD.v || '->' || NEW.v);
CREATE RULE
