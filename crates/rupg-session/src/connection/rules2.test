> CREATE TABLE r_other (id int, v text);
CREATE TABLE
> CREATE RULE r_redirect AS ON INSERT TO r_other WHERE NEW.id < 0 DO INSTEAD INSERT INTO r_log VALUES ('neg', NEW.id, NEW.v);
CREATE RULE
