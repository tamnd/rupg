> CREATE TABLE r_base (id int, v text);
CREATE TABLE
> CREATE VIEW r_view AS SELECT id, v FROM r_base;
CREATE VIEW
> CREATE RULE r_view_ins AS ON INSERT TO r_view DO INSTEAD INSERT INTO r_base VALUES (NEW.id, upper(NEW.v));
CREATE RULE
> CREATE RULE r_view_upd AS ON UPDATE TO r_view DO INSTEAD UPDATE r_base SET v = NEW.v WHERE id = OLD.id;
CREATE RULE
> CREATE RULE r_view_del AS ON DELETE TO r_view DO INSTEAD DELETE FROM r_base WHERE id = OLD.id;
CREATE RULE
