!details
> SET TimeZone = 'UTC'
SET
> CREATE TABLE mt_base (a int PRIMARY KEY, b text);
CREATE TABLE
> INSERT INTO mt_base VALUES (1, 'one'), (2, 'two'), (3, 'three');
INSERT 0 3
> CREATE VIEW mt_v AS SELECT a, b, a * 10 AS c FROM mt_base;
CREATE VIEW
> CREATE TABLE mt_log (seq serial, op text, old_row text, new_row text);
CREATE TABLE
> CREATE FUNCTION mt_instead() RETURNS trigger LANGUAGE plpgsql AS $$
>> BEGIN
>>   INSERT INTO mt_log (op, old_row, new_row) VALUES (TG_OP, OLD::text, NEW::text);
>>   IF TG_OP = 'INSERT' THEN
>>     IF NEW.a = 99 THEN RETURN NULL; END IF;
>>     INSERT INTO mt_base VALUES (NEW.a, NEW.b);
>>     NEW.b := NEW.b || ' (ins)';
>>     RETURN NEW;
>>   ELSIF TG_OP = 'UPDATE' THEN
>>     UPDATE mt_base SET a = NEW.a, b = NEW.b WHERE a = OLD.a;
>>     NEW.b := NEW.b || ' (upd)';
>>     RETURN NEW;
>>   ELSE
>>     DELETE FROM mt_base WHERE a = OLD.a;
>>     RETURN OLD;
>>   END IF;
>> END $$;
CREATE FUNCTION
> CREATE FUNCTION mt_stmt() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE NOTICE '% % statement on %', TG_WHEN, TG_OP, TG_TABLE_NAME; RETURN NULL; END $$;
CREATE FUNCTION
> CREATE TRIGGER mt_ins INSTEAD OF INSERT ON mt_v FOR EACH ROW EXECUTE FUNCTION mt_instead();
CREATE TRIGGER
> CREATE TRIGGER mt_upd INSTEAD OF UPDATE ON mt_v FOR EACH ROW EXECUTE FUNCTION mt_instead();
CREATE TRIGGER
> CREATE TRIGGER mt_del INSTEAD OF DELETE ON mt_v FOR EACH ROW EXECUTE FUNCTION mt_instead();
CREATE TRIGGER
> CREATE TRIGGER mt_bs BEFORE INSERT OR UPDATE OR DELETE ON mt_v FOR EACH STATEMENT EXECUTE FUNCTION mt_stmt();
CREATE TRIGGER
> CREATE TRIGGER mt_as AFTER INSERT OR UPDATE OR DELETE ON mt_v FOR EACH STATEMENT EXECUTE FUNCTION mt_stmt();
CREATE TRIGGER
