> CREATE FUNCTION trg() RETURNS trigger LANGUAGE plpgsql AS $$
>> BEGIN
>>   RAISE NOTICE '% % % on %', TG_WHEN, TG_LEVEL, TG_OP, TG_TABLE_NAME;
>>   IF TG_OP = 'UPDATE' AND TG_LEVEL = 'ROW' AND TG_TABLE_NAME = 'c1' THEN
>>     NEW.x := NEW.x + 1;
>>   END IF;
>>   IF TG_LEVEL = 'ROW' AND TG_OP = 'DELETE' THEN
>>     RETURN OLD;
>>   END IF;
>>   IF TG_LEVEL = 'ROW' THEN
>>     RETURN NEW;
>>   END IF;
>>   RETURN NULL;
>> END $$;
CREATE FUNCTION
> CREATE TRIGGER ps BEFORE UPDATE OR DELETE ON p FOR EACH STATEMENT EXECUTE FUNCTION trg();
CREATE TRIGGER
> CREATE TRIGGER pr BEFORE UPDATE OR DELETE ON p FOR EACH ROW EXECUTE FUNCTION trg();
