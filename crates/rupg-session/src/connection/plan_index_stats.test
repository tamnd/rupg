> CREATE TABLE ic (a int, b int, c int, d text, p text);
CREATE TABLE
> INSERT INTO ic SELECT x, 300 - x, (x * 7) % 300, 'v' || lpad((x % 50)::text, 3, '0'), repeat('p', 300) FROM generate_series(1, 300) x;
INSERT 0 300
