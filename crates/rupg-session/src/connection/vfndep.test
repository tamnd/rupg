!details
> SET TimeZone = 'UTC'
SET
> create table tt14t (f1 text, f2 text, f3 text, f4 text);
CREATE TABLE
> insert into tt14t values('foo', 'bar', 'baz', '42');
INSERT 0 1
> alter table tt14t drop column f2;
ALTER TABLE
> create function tt14f() returns setof tt14t as $$ declare rec1 record; begin for rec1 in select * from tt14t loop return next rec1; end loop; end; $$ language plpgsql;
CREATE FUNCTION
> create view tt14v as select t.* from tt14f() t;
CREATE VIEW
> select pg_get_viewdef('tt14v', true);
fields pg_get_viewdef:25:-1:-1
row  SELECT f1,
    f3,
    f4
   FROM tt14f() t(f1, f3, f4);
SELECT 1
> select * from tt14v;
fields f1@tt14v.1:25:-1:-1,f3@tt14v.2:25:-1:-1,f4@tt14v.3:25:-1:-1
row foo,baz,42
SELECT 1
> alter table tt14t drop column f3;
ERROR 2BP01 cannot drop column f3 of table tt14t because other objects depend on it
DETAIL view tt14v depends on column f3 of table tt14t
HINT Use DROP ... CASCADE to drop the dependent objects too.
> alter table tt14t alter column f4 type integer using f4::integer;
ERROR 0A000 cannot alter type of a column used by a view or rule
DETAIL rule _RETURN on view tt14v depends on column "f4".
> select pg_describe_object(classid, objid, objsubid) as obj, pg_describe_object(refclassid, refobjid, refobjsubid) as ref, deptype from pg_depend where objid = (select oid from pg_rewrite where ev_class = 'tt14v'::regclass and rulename = '_RETURN') and refobjsubid > 0 order by refobjsubid;
fields obj:25:-1:-1,ref:25:-1:-1,deptype@pg_depend.7:18:1:-1
row rule _RETURN on view tt14v,column f1 of table tt14t,n
row rule _RETURN on view tt14v,column f3 of table tt14t,n
row rule _RETURN on view tt14v,column f4 of table tt14t,n
SELECT 3
