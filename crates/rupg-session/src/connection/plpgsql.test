> CREATE FUNCTION raiser(n int) RETURNS void AS $$
>> BEGIN
>>   RAISE NOTICE 'n is %', n;
>>   RAISE WARNING 'warn % and %', n, n + 1;
>>   RAISE INFO 'info';
>>   IF n > 1 THEN
>>     RAISE EXCEPTION 'too big: %', n USING HINT = 'use a smaller number', DETAIL = 'some detail';
>>   END IF;
>> END
>> $$ LANGUAGE plpgsql;
