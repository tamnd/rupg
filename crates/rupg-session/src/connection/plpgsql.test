> CREATE FUNCTION cases(n int) RETURNS text AS $$
>> BEGIN
>>   CASE n
>>     WHEN 1, 2 THEN RETURN 'low';
>>     WHEN 3 THEN RETURN 'mid';
>>     ELSE RETURN 'high';
>>   END CASE;
>> END
>> $$ LANGUAGE plpgsql;
