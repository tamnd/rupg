> CREATE FUNCTION stacked() RETURNS text AS $$
>> DECLARE
>>   msg text;
>>   st text;
>>   det text;
>> BEGIN
>>   RAISE EXCEPTION 'boom' USING DETAIL = 'the detail', ERRCODE = 'P0001';
>> EXCEPTION WHEN raise_exception THEN
>>   GET STACKED DIAGNOSTICS msg = MESSAGE_TEXT, st = RETURNED_SQLSTATE, det = PG_EXCEPTION_DETAIL;
>>   RETURN msg || '/' || st || '/' || det;
>> END
>> $$ LANGUAGE plpgsql;
CREATE FUNCTION
> SELECT stacked();
fields stacked:25:-1:-1
row boom/P0001/the detail
