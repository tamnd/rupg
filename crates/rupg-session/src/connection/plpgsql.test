> CREATE FUNCTION tab(n int) RETURNS TABLE (k int, sq int) AS $$
>> BEGIN
>>   FOR i IN 1..n LOOP
>>     k := i;
>>     sq := i * i;
>>     RETURN NEXT;
>>   END LOOP;
>> END
>> $$ LANGUAGE plpgsql;
