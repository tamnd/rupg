> CREATE FUNCTION loops() RETURNS text AS $$
>> DECLARE
>>   s text := '';
>>   i int := 0;
>> BEGIN
>>   LOOP
>>     i := i + 1;
>>     EXIT WHEN i > 5;
>>     CONTINUE WHEN i = 3;
>>     s := s || i;
>>   END LOOP;
>>   WHILE i > 0 LOOP
>>     i := i - 2;
>>     s := s || ',' || i;
>>   END LOOP;
>>   FOR j IN REVERSE 10..1 BY 3 LOOP
>>     s := s || ' ' || j;
>>   END LOOP;
>>   <<outer>>
>>   FOR a IN 1..3 LOOP
>>     FOR b IN 1..3 LOOP
>>       CONTINUE outer WHEN b = 2;
>>       s := s || ' ' || a || b;
>>     END LOOP;
>>   END LOOP outer;
>>   RETURN s;
>> END
>> $$ LANGUAGE plpgsql;
CREATE FUNCTION
> SELECT loops();
fields loops:25:-1:-1
row 1245,4,2,0 10 7 4 1 11 21 31
SELECT 1
> CREATE FUNCTION sum_t() RETURNS int AS $$
>> DECLARE
>>   total int := 0;
>>   r record;
>> BEGIN
>>   FOR r IN SELECT * FROM t ORDER BY a LOOP
>>     total := total + r.a;
>>     RAISE NOTICE 'row % %', r.a, r.b;
>>   END LOOP;
>>   RETURN total;
>> END
>> $$ LANGUAGE plpgsql;
