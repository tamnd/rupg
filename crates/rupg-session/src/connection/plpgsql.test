> CREATE FUNCTION dyn(tbl text) RETURNS bigint AS $$
>> DECLARE
>>   n bigint;
>> BEGIN
>>   EXECUTE 'SELECT count(*) FROM ' || quote_ident(tbl) INTO n;
>>   EXECUTE 'SELECT count(*) FROM t WHERE a > $1' INTO n USING 1;
>>   RETURN n;
>> END
>> $$ LANGUAGE plpgsql;
