> CREATE FUNCTION catcher(n int) RETURNS text AS $$
>> DECLARE
>>   v int;
>> BEGIN
>>   BEGIN
>>     v := 10 / n;
>>     RETURN 'ok ' || v;
>>   EXCEPTION
>>     WHEN division_by_zero THEN
>>       RETURN 'caught ' || SQLSTATE || ' ' || SQLERRM;
>>   END;
>> END
>> $$ LANGUAGE plpgsql;
CREATE FUNCTION
