> CREATE FUNCTION rollback_block() RETURNS int AS $$
>> DECLARE
>>   n int;
>> BEGIN
>>   BEGIN
>>     INSERT INTO t VALUES (100, 'hundred');
>>     RAISE EXCEPTION 'undo';
>>   EXCEPTION WHEN OTHERS THEN
>>     RAISE NOTICE 'caught %', SQLERRM;
>>   END;
>>   SELECT count(*) INTO n FROM t WHERE a = 100;
>>   RETURN n;
>> END
>> $$ LANGUAGE plpgsql;
CREATE FUNCTION
