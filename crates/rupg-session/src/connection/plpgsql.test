> CREATE FUNCTION classify(n int) RETURNS text AS $$
>> BEGIN
>>   IF n < 0 THEN
>>     RETURN 'negative';
>>   ELSIF n = 0 THEN
>>     RETURN 'zero';
>>   ELSE
>>     RETURN 'positive';
>>   END IF;
>> END
>> $$ LANGUAGE plpgsql;
