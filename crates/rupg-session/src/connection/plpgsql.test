> CREATE FUNCTION ins(k int, v text) RETURNS int AS $$
>> DECLARE
>>   n int;
>> BEGIN
>>   INSERT INTO t VALUES (k, v);
>>   GET DIAGNOSTICS n = ROW_COUNT;
>>   UPDATE t SET b = upper(b) WHERE a <= k;
>>   GET DIAGNOSTICS n = ROW_COUNT;
>>   RETURN n;
>> END
>> $$ LANGUAGE plpgsql;
