> CREATE FUNCTION fact(n int) RETURNS bigint AS $$
>> DECLARE
>>   r bigint := 1;
>>   i int;
>> BEGIN
>>   FOR i IN 1..n LOOP
>>     r := r * i;
>>   END LOOP;
>>   RETURN r;
>> END;
>> $$ LANGUAGE plpgsql;
