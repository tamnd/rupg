> CREATE FUNCTION tt() RETURNS trigger LANGUAGE plpgsql AS $$
>> DECLARE r record;
>> BEGIN
>>   IF TG_OP IN ('INSERT', 'UPDATE') THEN
>>     FOR r IN SELECT * FROM newt ORDER BY a LOOP RAISE NOTICE '% new %', TG_OP, r; END LOOP;
>>   END IF;
>>   IF TG_OP IN ('UPDATE', 'DELETE') THEN
>>     FOR r IN SELECT * FROM oldt ORDER BY a LOOP RAISE NOTICE '% old %', TG_OP, r; END LOOP;
>>   END IF;
>>   RETURN NULL;
>> END $$;
CREATE FUNCTION
> CREATE TRIGGER ti AFTER INSERT ON p REFERENCING NEW TABLE AS newt FOR EACH STATEMENT EXECUTE FUNCTION tt();
CREATE TRIGGER
> CREATE TRIGGER tu AFTER UPDATE ON p REFERENCING OLD TABLE AS oldt NEW TABLE AS newt FOR EACH STATEMENT EXECUTE FUNCTION tt();
CREATE TRIGGER
> CREATE TRIGGER td AFTER DELETE ON p REFERENCING OLD TABLE AS oldt FOR EACH STATEMENT EXECUTE FUNCTION tt();
