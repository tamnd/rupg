> EXPLAIN (VERBOSE, COSTS OFF) UPDATE ct SET b = 'y' WHERE a = 15
fields QUERY PLAN:25:-1:-1
row Update on public.ct
row   Update on public.ct ct_1
row   Update on public.ct2 ct_2
row   ->  Result
row         Output: 'y'::text, ct.tableoid, ct.ctid
row         ->  Append
row               ->  Seq Scan on public.ct ct_1
row                     Output: ct_1.tableoid, ct_1.ctid
row                     Filter: (ct_1.a = 15)
row               ->  Seq Scan on public.ct2 ct_2
row                     Output: ct_2.tableoid, ct_2.ctid
row                     Filter: (ct_2.a = 15)
EXPLAIN
