> CREATE TABLE lg (i int, u int, s text, k int, f float8, w int)
CREATE TABLE
> INSERT INTO lg SELECT i, (i::bigint * 7919 % 300000)::int, CASE WHEN i % 11 = 0 THEN NULL ELSE 'x' || (i % 3) END, i % 10, CASE WHEN i > 200000 THEN '-0'::float8 ELSE 0::float8 END, CASE WHEN i % 7 = 1 THEN NULL ELSE 1 + (i::bigint * 104729 % 100000)::int END FROM generate_series(1, 400000) i
