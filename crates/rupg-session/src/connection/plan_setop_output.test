> explain (verbose, costs off) select 1,2 union select 3,4;
fields QUERY PLAN:25:-1:-1
row Unique
row   Output: (1), (2)
row   ->  Sort
row         Output: (1), (2)
row         Sort Key: (1), (2)
row         ->  Append
row               ->  Result
row                     Output: 1, 2
row               ->  Result
row                     Output: 3, 4
EXPLAIN
> explain (verbose, costs off) select 1 union all select 2 limit 1;
