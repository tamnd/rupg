> explain (verbose, costs off) select x, x+1 from (select 1 union select 2) s(x) order by 2;
fields QUERY PLAN:25:-1:-1
row Sort
row   Output: s.x, ((s.x + 1))
row   Sort Key: ((s.x + 1))
row   ->  Subquery Scan on s
row         Output: s.x, (s.x + 1)
row         ->  Unique
row               Output: (1)
row               ->  Sort
row                     Output: (1)
row                     Sort Key: (1)
row                     ->  Append
row                           ->  Result
