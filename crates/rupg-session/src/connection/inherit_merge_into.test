> CREATE FUNCTION tr() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE NOTICE '% % % on %', TG_WHEN, TG_LEVEL, TG_OP, TG_TABLE_NAME; IF TG_LEVEL = 'ROW' AND TG_OP <> 'DELETE' THEN RETURN NEW; ELSIF TG_LEVEL = 'ROW' THEN RETURN OLD; END IF; RETURN NULL; END $$;
CREATE FUNCTION
> CREATE TRIGGER ps BEFORE INSERT OR UPDATE OR DELETE ON p FOR EACH STATEMENT EXECUTE FUNCTION tr();
CREATE TRIGGER
> CREATE TRIGGER pr BEFORE INSERT OR UPDATE OR DELETE ON p FOR EACH ROW EXECUTE FUNCTION tr();
