> SET TimeZone = 'UTC'
SET
> create table ic (i int, v varchar(10), n name, b bool, t timestamptz, d date, c char(4), f float8);
CREATE TABLE
> insert into ic values (1, 'a', 'nm', true, '2020-01-02 03:04:05+00', '2020-01-02', 'xy', 1.5), (2, null, null, null, null, null, null, null);
INSERT 0 2
