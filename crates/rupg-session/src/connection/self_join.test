!details
> create table sj (a int unique, b int, c int unique)
CREATE TABLE
> insert into sj values (1, null, 2), (null, 2, null), (2, 1, 1), (3, 1, 3)
INSERT 0 4
> explain (costs off) select p.* from sj p, sj q where q.a = p.a and q.b = q.a - 1
fields QUERY PLAN:25:-1:-1
row Seq Scan on sj q
row   Filter: ((a IS NOT NULL) AND (b = (a - 1)))
EXPLAIN
> select p.* from sj p, sj q where q.a = p.a and q.b = q.a - 1
fields a@sj.1:23:4:-1,b@sj.2:23:4:-1,c@sj.3:23:4:-1
row 2,1,1
SELECT 1
> explain (costs off) select * from sj p where exists (select * from sj q where q.a = p.a and q.b < 10)
fields QUERY PLAN:25:-1:-1
row Seq Scan on sj q
row   Filter: ((a IS NOT NULL) AND (b < 10))
EXPLAIN
> explain (costs off) select * from sj t1, sj t2 where t1.a = t2.c and t1.b is not null
fields QUERY PLAN:25:-1:-1
row Hash Join
row   Hash Cond: (t2.c = t1.a)
row   ->  Seq Scan on sj t2
row   ->  Hash
row         ->  Seq Scan on sj t1
row               Filter: (b IS NOT NULL)
EXPLAIN
> explain (costs off) select t3.a from sj t1 join sj t2 on t1.a = t2.a and t1.b = t2.b join sj t3 on t2.a = t3.a and t2.b + 1 = t3.b + 1
fields QUERY PLAN:25:-1:-1
row Seq Scan on sj t3
row   Filter: ((a IS NOT NULL) AND (b IS NOT NULL) AND ((b + 1) IS NOT NULL))
EXPLAIN
> explain (costs off) select * from sj j1, sj j2 where j1.b = j2.b and j1.a = 2 and j2.a = 3
fields QUERY PLAN:25:-1:-1
row Nested Loop
row   Join Filter: (j1.b = j2.b)
row   ->  Index Scan using sj_a_key on sj j1
row         Index Cond: (a = 2)
row   ->  Index Scan using sj_a_key on sj j2
row         Index Cond: (a = 3)
EXPLAIN
> explain (costs off) select * from sj j1, sj j2 where j1.b = j2.b and j1.a = 2 and j2.a = 2
fields QUERY PLAN:25:-1:-1
row Index Scan using sj_a_key on sj j2
row   Index Cond: (a = 2)
row   Filter: (b IS NOT NULL)
EXPLAIN
> explain (costs off) select * from sj x left join (sj y join sj z on y.a = z.a) on x.c = y.c
fields QUERY PLAN:25:-1:-1
row Hash Left Join
row   Hash Cond: (x.c = z.c)
row   ->  Seq Scan on sj x
row   ->  Hash
row         ->  Seq Scan on sj z
row               Filter: (a IS NOT NULL)
EXPLAIN
> explain (costs off) select x.a, y.b from sj x join sj y using (a) where y.c > 0
fields QUERY PLAN:25:-1:-1
row Bitmap Heap Scan on sj y
row   Recheck Cond: (c > 0)
row   Filter: (a IS NOT NULL)
row   ->  Bitmap Index Scan on sj_c_key
row         Index Cond: (c > 0)
EXPLAIN
> set enable_self_join_elimination = off
SET
> explain (costs off) select p.* from sj p, sj q where q.a = p.a
fields QUERY PLAN:25:-1:-1
row Hash Join
row   Hash Cond: (p.a = q.a)
row   ->  Seq Scan on sj p
row   ->  Hash
row         ->  Seq Scan on sj q
EXPLAIN
