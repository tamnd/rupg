> CREATE VIEW osa_v AS SELECT g, percentile_disc(0.5) WITHIN GROUP (ORDER BY x DESC NULLS LAST) AS a, percentile_cont(array[0.1, 0.9]) WITHIN GROUP (ORDER BY i) FILTER (WHERE g > 1) AS b, mode() WITHIN GROUP (ORDER BY s USING >) AS c, rank(1, 'z') WITHIN GROUP (ORDER BY g, s) AS d, dense_rank(2.5) WITHIN GROUP (ORDER BY n) AS e FROM osa_t GROUP BY g
CREATE VIEW
> SELECT pg_get_viewdef('osa_v'::regclass)
fields pg_get_viewdef:25:-1:-1
row  SELECT g,
    percentile_disc((0.5)::double precision) WITHIN GROUP (ORDER BY x DESC NULLS LAST) AS a,
    percentile_cont((ARRAY[0.1, 0.9])::double precision[]) WITHIN GROUP (ORDER BY i) FILTER (WHERE (g > 1)) AS b,
    mode() WITHIN GROUP (ORDER BY s DESC) AS c,
    rank(1, 'z'::text) WITHIN GROUP (ORDER BY g, s) AS d,
    dense_rank(2.5) WITHIN GROUP (ORDER BY ((n)::numeric)) AS e
   FROM osa_t
  GROUP BY g;
