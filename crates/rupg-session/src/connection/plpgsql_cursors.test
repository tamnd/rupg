row 1,one
row 2,two
FETCH 2
> FETCH ALL FROM cx;
fields a@t.1:23:4:-1,b@t.2:25:-1:-1
row 3,three
FETCH 1
> CLOSE cx;
CLOSE CURSOR
> COMMIT;
COMMIT
