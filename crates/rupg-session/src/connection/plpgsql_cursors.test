> CREATE FUNCTION f_open(c refcursor) RETURNS refcursor LANGUAGE plpgsql AS $$ BEGIN OPEN c FOR SELECT a, b FROM t ORDER BY a; RETURN c; END $$;
CREATE FUNCTION
> BEGIN;
BEGIN
> SELECT f_open('cx');
